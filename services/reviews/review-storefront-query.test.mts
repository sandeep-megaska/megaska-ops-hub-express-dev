import test from "node:test";
import assert from "node:assert/strict";
import { getPublishedProductReviews, normalizeShopifyProductId } from "./review-storefront-query.ts";
test("normalizes Shopify product IDs",()=>{assert.equal(normalizeShopifyProductId("123"),"123");assert.equal(normalizeShopifyProductId("gid://shopify/Product/123"),"123");assert.equal(normalizeShopifyProductId("gid://shopify/Variant/123"),null);assert.equal(normalizeShopifyProductId("product"),null);assert.equal(normalizeShopifyProductId(""),null);});
test("queries only published reviews within tenant and projects public fields",async()=>{let seen:any;const db:any={productReview:{findMany:async(a:any)=>{seen=a;return [{id:"r",rating:5,title:null,body:null,customerDisplayName:"A",verifiedPurchase:true,productTitleSnapshot:"P",variantTitleSnapshot:null,createdAt:new Date(),publishedAt:new Date()}];},count:async()=>1},productReviewAggregate:{findUnique:async()=>({averageRating:"5.000",publishedCount:1,rating1Count:0,rating2Count:0,rating3Count:0,rating4Count:0,rating5Count:1})}};const data=await getPublishedProductReviews({shopId:"a",shopifyProductId:"1",page:1,pageSize:99,sort:"NEWEST",db});assert.deepEqual(seen.where,{shopId:"a",shopifyProductId:"1",status:"PUBLISHED",deletedAt:null});assert.equal(data.pageSize,25);assert.deepEqual(Object.keys(data.items[0]).sort(),["body","createdAt","customerDisplayName","id","productTitleSnapshot","publishedAt","rating","title","variantTitleSnapshot","verifiedPurchase"].sort());});
test("missing aggregate has zero summary and pagination flags",async()=>{const db:any={productReview:{findMany:async()=>[],count:async()=>0},productReviewAggregate:{findUnique:async()=>null}};const data=await getPublishedProductReviews({shopId:"a",shopifyProductId:"1",page:2,pageSize:10,db});assert.equal(data.summary.reviewCount,0);assert.equal(data.totalPages,0);assert.equal(data.hasPreviousPage,true);assert.equal(data.hasNextPage,false);});
