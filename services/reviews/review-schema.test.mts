import test from "node:test"; import assert from "node:assert/strict"; import { readFileSync } from "node:fs";
test("review schema and migration contain database invariants",()=>{const schema=readFileSync("prisma/schema.prisma","utf8"),sql=readFileSync("prisma/migrations/20260716000000_add_review_foundation/migration.sql","utf8");for(const value of ["model ReviewSettings","model ReviewRequest","model ProductReview","deliveredAt","@@index([shopId, deliveredAt])"])assert.ok(schema.includes(value));assert.match(sql,/ProductReview_rating_range_check/);assert.match(sql,/ProductReviewAggregate_average_range_check/);});
