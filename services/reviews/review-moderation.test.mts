import assert from "node:assert/strict";
import test from "node:test";
import { moderateReview, normalizeRejectionReason } from "./review-moderation.ts";
function db(review:{id:string;shopId:string;shopifyProductId:string;status:string}){let aggregateCalls=0;const tx={productReview:{findFirst:async({where}:{where:{id:string;shopId:string}})=>where.id===review.id&&where.shopId===review.shopId?review:null,update:async({data}:{data:Record<string,unknown>})=>Object.assign(review,data),findMany:async()=>review.status==="PUBLISHED"?[{rating:5,publishedAt:null}]:[]},productReviewAggregate:{upsert:async()=>{aggregateCalls++}}};return {db:{$transaction:async(fn:(value:typeof tx)=>unknown)=>fn(tx),...tx},calls:()=>aggregateCalls}}
test("moderation publishes pending reviews and recalculates aggregate",async()=>{const review={id:"r",shopId:"a",shopifyProductId:"p",status:"PENDING_MODERATION"};const mock=db(review);const result=await moderateReview({shopId:"a",reviewId:"r",action:"PUBLISH",actorId:"admin",now:new Date("2026-01-01"),db:mock.db as never});assert.deepEqual(result,{ok:true,status:"PUBLISHED"});assert.equal(review.status,"PUBLISHED");assert.equal(mock.calls(),1)});
test("moderation is tenant scoped and repeated actions have no aggregate side effect",async()=>{const review={id:"r",shopId:"a",shopifyProductId:"p",status:"PUBLISHED"};const mock=db(review);assert.deepEqual(await moderateReview({shopId:"b",reviewId:"r",action:"REJECT",actorId:"admin",db:mock.db as never}),{ok:false,errorCode:"REVIEW_NOT_FOUND"});assert.equal(mock.calls(),0);assert.deepEqual(await moderateReview({shopId:"a",reviewId:"r",action:"PUBLISH",actorId:"admin",db:mock.db as never}),{ok:false,errorCode:"REVIEW_ALREADY_PUBLISHED"});assert.equal(mock.calls(),0)});
test("reject, unpublish, and republish clear publication metadata consistently",async()=>{const review={id:"r",shopId:"a",shopifyProductId:"p",status:"PUBLISHED"};const mock=db(review);await moderateReview({shopId:"a",reviewId:"r",action:"REJECT",rejectionReason:"  Not relevant ",actorId:"admin",db:mock.db as never});assert.equal(review.status,"REJECTED");assert.equal((review as Record<string,unknown>).publishedAt,null);assert.equal((review as Record<string,unknown>).rejectionReason,"Not relevant");await moderateReview({shopId:"a",reviewId:"r",action:"UNPUBLISH",actorId:"admin",db:mock.db as never});assert.equal(review.status,"PENDING_MODERATION");await moderateReview({shopId:"a",reviewId:"r",action:"PUBLISH",actorId:"admin",db:mock.db as never});assert.equal(review.status,"PUBLISHED");assert.equal((review as Record<string,unknown>).rejectionReason,null);assert.equal(mock.calls(),2)});
test("rejection reasons are plain text and limited",()=>{assert.equal(normalizeRejectionReason("  Internal note ").value,"Internal note");assert.ok(normalizeRejectionReason("<b>no</b>").error);assert.deepEqual(normalizeRejectionReason("x".repeat(501)).value,"x".repeat(501));});
