import test from "node:test"; import assert from "node:assert/strict"; import { recordCanonicalOrderDelivery } from "./canonical-delivery.ts";
function db(order:any){return {megaskaOrder:{findFirst:async()=>order,update:async({data}:any)=>Object.assign(order,data)}}}
test("records delivery idempotently and never overrides terminal status",async()=>{const order={id:"o",shopId:"s",orderPlacedAt:new Date("2026-01-01T00:00:00Z"),deliveredAt:null,deliverySource:null,status:"PROCESSING"};await recordCanonicalOrderDelivery({shopId:"s",megaskaOrderId:"o",deliveredAt:"2026-01-02T00:00:00Z",source:"COURIER_SHIPMENT"},db(order) as any);assert.equal(order.status,"DELIVERED");assert.equal((order.deliveredAt as Date).toISOString(),"2026-01-02T00:00:00.000Z");});
test("rejects incorrect tenant and timestamp",async()=>{const order={id:"o",shopId:"s",orderPlacedAt:null,deliveredAt:null,deliverySource:null,status:"PROCESSING"};await assert.rejects(()=>recordCanonicalOrderDelivery({shopId:"wrong",megaskaOrderId:"o",deliveredAt:"bad",source:"MIGRATED"},db(null) as any));await assert.rejects(()=>recordCanonicalOrderDelivery({shopId:"s",megaskaOrderId:"o",deliveredAt:"2026-01-01",source:"MIGRATED"},db(order) as any));});
