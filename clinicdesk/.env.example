# Postgres. Use ap-south-1 (Mumbai) for data residency — patient records.
DATABASE_URL="postgresql://user:pass@localhost:5432/clinicdesk?schema=public"

# Root domain that tenant subdomains hang off, e.g. heal.clinicdesk.in
NEXT_PUBLIC_ROOT_DOMAIN="clinicdesk.local:3000"
APP_BASE_URL="http://localhost:3000"

# Signs shareable document links. 32+ random bytes. Rotating it invalidates
# every outstanding patient document link, which is the intended panic button.
DOCUMENT_URL_SECRET="change-me-to-32-bytes-of-random"
SESSION_SECRET="change-me-too-32-bytes-of-random"

# Outbound. All optional in dev — unset providers log to stdout instead.
RESEND_API_KEY=""
WHATSAPP_PROVIDER=""          # meta | gupshup | aisensy
WHATSAPP_API_KEY=""
WHATSAPP_SENDER=""

# Clinical narrative drafting. Leave unset to disable the AI draft button.
ANTHROPIC_API_KEY=""

# Set true to print staff login codes to the server log instead of emailing.
DEV_LOGIN_CODES="true"
