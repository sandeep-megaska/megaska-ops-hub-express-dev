// ClinicDesk — multi-tenant clinic OS for allied-health practices.
//
// Tenancy: one Postgres database, `clinicId` on every tenant-owned row.
// Never query these models through the bare client — use `clinicScope()` from
// lib/db.ts, which injects and enforces the filter. See AGENTS.md.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

enum ClinicStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

model Clinic {
  id     String       @id @default(uuid())
  slug   String       @unique // "heal" -> /book/heal, heal.clinicdesk.in
  name   String
  status ClinicStatus @default(ONBOARDING)

  // Scheduling is resolved against this. IANA name, e.g. "Asia/Kolkata".
  timezone String @default("Asia/Kolkata")
  locale   String @default("en-IN")
  currency String @default("INR")

  // Public-facing contact, also used on documents.
  publicEmail   String?
  publicPhone   String?
  websiteUrl    String?
  addressLines  String[] @default([])
  mapUrl        String?

  // Brand
  primaryColor String? @default("#0f766e")
  logoUrl      String?

  // Healthcare services are GST-exempt and the pilot clinic is unregistered.
  // This stays null for every tenant until one has non-exempt revenue
  // (equipment sales, a wellness arm). Nothing in the core reads it yet.
  taxProfile Json?

  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  domains            ClinicDomain[]
  letterheads        Letterhead[]
  staff              StaffUser[]
  practitioners      Practitioner[]
  services           Service[]
  availabilityRules  AvailabilityRule[]
  scheduleExceptions ScheduleException[]
  patients           Patient[]
  episodes           Episode[]
  appointments       Appointment[]
  visitNotes         VisitNote[]
  templates          DocumentTemplate[]
  documents          ClinicalDocument[]
  counters           DocumentCounter[]
  packages           SessionPackage[]
  bills              Bill[]
  payments           Payment[]
  consents           Consent[]
  auditEvents        AuditEvent[]
  notifications      NotificationLog[]
  settings           ClinicSettings?

  @@index([status])
}

/// Custom domains: book.healphysiotherapy.in -> this clinic. Verified by CNAME.
model ClinicDomain {
  id         String    @id @default(uuid())
  clinicId   String
  hostname   String    @unique
  isPrimary  Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}

model ClinicSettings {
  id       String @id @default(uuid())
  clinicId String @unique

  // Booking rules
  slotGranularityMins Int     @default(15)
  minNoticeMins       Int     @default(120)
  maxAdvanceDays      Int     @default(60)
  allowOnlineBooking  Boolean @default(true)
  requireOtpToBook    Boolean @default(true)

  // Which origins may embed the booking widget. Empty = any (dev only).
  embedAllowedOrigins String[] @default([])

  // Reminders (hours before appointment). Empty disables.
  reminderOffsetsHours Int[] @default([24, 2])

  // Messaging provider config, per tenant. Mirrors the provider-settings
  // pattern already proven in megaska-ops-hub.
  whatsappProvider String?
  whatsappSender   String?
  whatsappApiKeyEnc String?

  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Letterhead — the pilot prints every document on her own letterhead, so this
// is a first-class tenant asset, not a styling detail.
// ---------------------------------------------------------------------------

enum LetterheadMode {
  /// Compose header/footer from structured fields + logo. Default.
  DIGITAL
  /// Render content only, reserving margins for pre-printed stationery.
  PRE_PRINTED
  /// Full-page scan of an existing letterhead as a background image.
  SCANNED_BACKGROUND
}

model Letterhead {
  id       String         @id @default(uuid())
  clinicId String
  name     String         @default("Default")
  mode     LetterheadMode @default(DIGITAL)
  isActive Boolean        @default(true)

  // DIGITAL
  practiceName   String?
  practitionerLine String?  // "Dr. A. Nair, MPT (Ortho)"
  registrationNo String?
  headerLines    String[] @default([])
  footerLines    String[] @default([])
  logoUrl        String?

  // SCANNED_BACKGROUND
  backgroundUrl String?

  // Page geometry, millimetres. PRE_PRINTED uses large top/bottom margins so
  // generated content lands below her printed header.
  pageSize     String @default("A4")
  marginTopMm  Int    @default(22)
  marginRightMm Int   @default(18)
  marginBottomMm Int  @default(20)
  marginLeftMm  Int   @default(18)

  // Signature block
  signatureImageUrl String?
  signatureName     String?
  signatureSubtitle String?
  /// When true, leave blank space for a wet signature instead of drawing one.
  wetSignature      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic    Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  documents ClinicalDocument[]

  @@index([clinicId, isActive])
}

// ---------------------------------------------------------------------------
// Staff & auth
// ---------------------------------------------------------------------------

enum StaffRole {
  OWNER
  PRACTITIONER
  FRONT_DESK
}

model StaffUser {
  id       String    @id @default(uuid())
  clinicId String
  email    String
  phoneE164 String?
  fullName String
  role     StaffRole @default(PRACTITIONER)
  isActive Boolean   @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  clinic       Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  practitioner Practitioner?
  sessions     StaffSession[]
  challenges   LoginChallenge[]

  @@unique([clinicId, email])
  @@index([clinicId])
}

model LoginChallenge {
  id          String    @id @default(uuid())
  staffUserId String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId, expiresAt])
}

model StaffSession {
  id          String    @id @default(uuid())
  staffUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now())

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
}

model Practitioner {
  id          String  @id @default(uuid())
  clinicId    String
  staffUserId String? @unique
  fullName    String
  qualifications String?
  registrationNo String?
  bio         String?
  photoUrl    String?
  isBookable  Boolean @default(true)
  displayOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic             Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  staffUser          StaffUser?          @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  services           Service[]
  availabilityRules  AvailabilityRule[]
  scheduleExceptions ScheduleException[]
  appointments       Appointment[]
  episodes           Episode[]
  visitNotes         VisitNote[]
  documents          ClinicalDocument[]

  @@index([clinicId, isBookable])
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

model Service {
  id       String  @id @default(uuid())
  clinicId String
  name     String
  description String?
  durationMins Int   @default(30)
  bufferMins   Int   @default(0)
  /// Minor units (paise). Null = "price on request".
  priceMinor   Int?
  isActive     Boolean @default(true)
  isTeleconsult Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  practitioners Practitioner[]
  appointments  Appointment[]
  packages      SessionPackage[]

  @@index([clinicId, isActive])
}

/// Recurring weekly availability, expressed in the clinic's wall-clock time.
model AvailabilityRule {
  id             String @id @default(uuid())
  clinicId       String
  practitionerId String

  /// 0 = Sunday … 6 = Saturday
  weekday   Int
  /// Minutes from local midnight, e.g. 540 = 09:00
  startMins Int
  endMins   Int

  effectiveFrom DateTime?
  effectiveTo   DateTime?

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([clinicId, practitionerId, weekday])
}

enum ScheduleExceptionKind {
  BLOCKED
  EXTRA_HOURS
}

model ScheduleException {
  id             String                @id @default(uuid())
  clinicId       String
  practitionerId String
  kind           ScheduleExceptionKind @default(BLOCKED)
  startAt        DateTime
  endAt          DateTime
  reason         String?

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([clinicId, practitionerId, startAt])
}

// ---------------------------------------------------------------------------
// Patients
// ---------------------------------------------------------------------------

enum Sex {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

model Patient {
  id        String  @id @default(uuid())
  clinicId  String
  /// Human-readable, per clinic: "HP-0042". Front desk speaks this, not a uuid.
  patientNo String

  fullName  String
  phoneE164 String?
  email     String?
  sex       Sex      @default(UNDISCLOSED)
  dateOfBirth DateTime?

  addressLines String[] @default([])
  city         String?
  country      String   @default("IN")
  /// Patients abroad book across timezones; reminders render in this zone.
  timezone     String?

  /// Free-text, surfaced prominently on the patient file.
  allergies      String?
  medicalHistory String?
  referredBy     String?

  notes String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  clinic       Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  episodes     Episode[]
  appointments Appointment[]
  visitNotes   VisitNote[]
  documents    ClinicalDocument[]
  packages     SessionPackage[]
  bills        Bill[]
  payments     Payment[]
  consents     Consent[]

  @@unique([clinicId, patientNo])
  @@unique([clinicId, phoneE164])
  @@index([clinicId, fullName])
}

enum ConsentType {
  TREATMENT
  DATA_PROCESSING
  TELECONSULT
  MARKETING
}

/// Versioned consent capture. DPDP Act 2023 expects the exact text shown to be
/// reproducible later, so the text is snapshotted, not referenced.
model Consent {
  id        String      @id @default(uuid())
  clinicId  String
  patientId String
  type      ConsentType
  version   String
  textShown String
  granted   Boolean
  grantedAt DateTime    @default(now())
  ip        String?
  userAgent String?

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId, type])
}

// ---------------------------------------------------------------------------
// Care: episode -> appointment -> visit note -> document
// ---------------------------------------------------------------------------

enum EpisodeStatus {
  ACTIVE
  DISCHARGED
  ABANDONED
}

/// A course of care: "L4-L5 disc prolapse, Jan–Mar". Discharge summaries are
/// written per episode, not per patient.
model Episode {
  id             String        @id @default(uuid())
  clinicId       String
  patientId      String
  practitionerId String?

  title           String
  presentingComplaint String?
  provisionalDiagnosis String?
  onsetDate       DateTime?
  status          EpisodeStatus @default(ACTIVE)
  startedAt       DateTime      @default(now())
  dischargedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic       Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner Practitioner?      @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  visitNotes   VisitNote[]
  documents    ClinicalDocument[]

  @@index([clinicId, patientId])
  @@index([clinicId, status])
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  EMBED_WIDGET
  BOOKING_PAGE
  FRONT_DESK
  PHONE
}

model Appointment {
  id             String @id @default(uuid())
  clinicId       String
  patientId      String
  practitionerId String
  serviceId      String
  episodeId      String?

  /// Always UTC. Render through services/scheduling/timezone.ts.
  startAt DateTime
  endAt   DateTime
  /// End of the slot this appointment occupies: `endAt` plus the service's
  /// turnaround buffer, captured at booking time. Stored rather than derived so
  /// that later editing a service's buffer cannot retroactively move the block
  /// on appointments already in the diary.
  blockEndAt DateTime
  /// IANA zone the booking was made in — reminders render in the patient's zone.
  bookedTimezone String?

  status AppointmentStatus @default(REQUESTED)
  source AppointmentSource @default(BOOKING_PAGE)

  /// What the patient typed into the booking form.
  reasonForVisit String?
  patientNotes   String?

  cancelledAt     DateTime?
  cancelledReason String?
  confirmedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  episode      Episode?     @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  visitNote    VisitNote?
  billLines    BillLine[]
  notifications NotificationLog[]

  @@index([clinicId, startAt])
  @@index([clinicId, practitionerId, startAt])
  @@index([clinicId, patientId])
}

enum VisitNoteStatus {
  DRAFT
  SIGNED
}

/// SOAP note. `objective` holds structured outcome measures so the discharge
/// summary can chart progress instead of restating prose.
model VisitNote {
  id             String @id @default(uuid())
  clinicId       String
  patientId      String
  episodeId      String?
  appointmentId  String? @unique
  practitionerId String

  visitDate  DateTime
  subjective String?
  objective  String?
  assessment String?
  plan       String?
  /// [{ code: "NPRS", label: "Pain (0-10)", value: "4" }, ...]
  measures   Json?
  /// Interventions applied this visit, for the discharge summary to aggregate.
  interventions String[] @default([])

  status   VisitNoteStatus @default(DRAFT)
  signedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  episode      Episode?     @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  @@index([clinicId, patientId, visitDate])
  @@index([clinicId, episodeId])
}

// ---------------------------------------------------------------------------
// Document engine — one pipeline, many document types. Adding a new type is a
// template row, not a code change.
// ---------------------------------------------------------------------------

enum DocumentType {
  DISCHARGE_SUMMARY
  PROGRESS_REPORT
  FITNESS_CERTIFICATE
  REFERRAL_LETTER
  HOME_EXERCISE_PROGRAMME
  RECEIPT
}

model DocumentTemplate {
  id       String       @id @default(uuid())
  clinicId String
  type     DocumentType
  name     String
  version  Int          @default(1)
  isActive Boolean      @default(true)

  /// Ordered field definitions rendered by the editor and the PDF:
  /// [{ key, label, kind: "text"|"textarea"|"measures"|"list"|"date",
  ///    hint?, required?, defaultValue? }]
  fields Json

  /// Handlebars-ish body. `{{field}}` and `{{#each}}` only — see
  /// services/documents/render.ts. Deliberately not a full template language.
  bodyHtml String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic    Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  documents ClinicalDocument[]

  @@unique([clinicId, type, name, version])
  @@index([clinicId, type, isActive])
}

enum DocumentStatus {
  DRAFT
  FINALISED
  SUPERSEDED
}

/// Immutable once FINALISED. A correction creates a new row pointing back via
/// `supersedesId` — an edited clinical record with no trail is a liability.
model ClinicalDocument {
  id             String @id @default(uuid())
  clinicId       String
  patientId      String
  episodeId      String?
  practitionerId String
  templateId     String?
  letterheadId   String?

  type   DocumentType
  status DocumentStatus @default(DRAFT)

  /// Sequential per clinic per type per financial year: "DS/2026-27/0007".
  documentNo String?

  title String

  /// Structured field values — the source of truth. The PDF is a projection.
  data Json

  /// Snapshot of the template body at finalisation, so re-rendering an old
  /// document can never be changed by a later template edit.
  renderedHtml String?
  pdfKey       String?

  finalisedAt   DateTime?
  finalisedById String?
  supersedesId  String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic       Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  episode      Episode?          @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  practitioner Practitioner      @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  template     DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  letterhead   Letterhead?       @relation(fields: [letterheadId], references: [id], onDelete: SetNull)

  supersedes ClinicalDocument? @relation("DocumentRevision", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy ClinicalDocument? @relation("DocumentRevision")

  shareLinks DocumentShareLink[]

  @@unique([clinicId, documentNo])
  @@index([clinicId, patientId, type])
  @@index([clinicId, status])
}

/// Expiring, revocable link for sending a document to a patient. Revoking a
/// single link must not require rotating the global signing secret.
model DocumentShareLink {
  id         String    @id @default(uuid())
  clinicId   String
  documentId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  viewCount  Int       @default(0)
  lastViewedAt DateTime?
  createdAt  DateTime  @default(now())

  document ClinicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([clinicId, documentId])
}

/// Per-clinic, per-type, per-financial-year sequence. Held in its own row so
/// allocation is a single atomic UPDATE ... RETURNING.
model DocumentCounter {
  id         String       @id @default(uuid())
  clinicId   String
  type       DocumentType
  /// Indian financial year label, "2026-27".
  fiscalYear String
  lastValue  Int          @default(0)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, type, fiscalYear])
}

// ---------------------------------------------------------------------------
// Billing — no tax engine. Healthcare services are GST-exempt and the pilot is
// unregistered, so what goes out is a payment receipt, not a tax invoice.
// ---------------------------------------------------------------------------

enum PackageStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

/// "10 sessions for Rs 6,000" — how physio actually sells. Credits decrement
/// as appointments complete.
model SessionPackage {
  id        String @id @default(uuid())
  clinicId  String
  patientId String
  serviceId String?

  name            String
  sessionsTotal   Int
  sessionsUsed    Int           @default(0)
  priceMinor      Int
  status          PackageStatus @default(ACTIVE)
  purchasedAt     DateTime      @default(now())
  expiresAt       DateTime?

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  billLines BillLine[]

  @@index([clinicId, patientId, status])
}

enum BillStatus {
  DRAFT
  ISSUED
  PAID
  PART_PAID
  CANCELLED
}

model Bill {
  id        String @id @default(uuid())
  clinicId  String
  patientId String

  /// "R/2026-27/0118"
  billNo String?

  status     BillStatus @default(DRAFT)
  issuedAt   DateTime?
  currency   String     @default("INR")
  /// Minor units throughout. Sum of lines.
  subtotalMinor Int     @default(0)
  discountMinor Int     @default(0)
  totalMinor    Int     @default(0)
  paidMinor     Int     @default(0)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic   Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient  Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  lines    BillLine[]
  payments Payment[]

  @@unique([clinicId, billNo])
  @@index([clinicId, patientId])
  @@index([clinicId, status])
}

model BillLine {
  id     String @id @default(uuid())
  billId String

  description   String
  quantity      Int @default(1)
  unitPriceMinor Int
  amountMinor    Int

  appointmentId String?
  packageId     String?

  bill        Bill            @relation(fields: [billId], references: [id], onDelete: Cascade)
  appointment Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  package     SessionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([billId])
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

model Payment {
  id        String @id @default(uuid())
  clinicId  String
  patientId String
  billId    String?

  amountMinor Int
  currency    String      @default("INR")
  mode        PaymentMode @default(UPI)
  reference   String?
  receivedAt  DateTime    @default(now())
  note        String?

  createdAt DateTime @default(now())

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bill    Bill?   @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([clinicId, patientId])
  @@index([clinicId, receivedAt])
}

// ---------------------------------------------------------------------------
// Audit & messaging
// ---------------------------------------------------------------------------

enum AuditAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  FINALISE
  SHARE
  LOGIN
  LOGOUT
  EXPORT
}

/// Reads are audited, not just writes — "who looked at this chart" is the
/// question that actually gets asked after an incident.
model AuditEvent {
  id       String @id @default(uuid())
  clinicId String

  actorStaffUserId String?
  actorLabel       String?

  action       AuditAction
  resourceType String
  resourceId   String?
  patientId    String?

  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
  @@index([clinicId, patientId])
  @@index([clinicId, resourceType, resourceId])
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model NotificationLog {
  id       String @id @default(uuid())
  clinicId String

  channel   NotificationChannel
  status    NotificationStatus  @default(QUEUED)
  template  String
  toAddress String

  appointmentId String?
  payload       Json?
  providerRef   String?
  error         String?

  sendAfter DateTime @default(now())
  sentAt    DateTime?
  createdAt DateTime @default(now())

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([clinicId, status, sendAfter])
  @@index([appointmentId])
}
