# Supabase: Project Settings > Database > Connection string.
# App runtime: the transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Migrations only: session pooler or direct connection (port 5432).
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Shopify (read-only app installed on the Megaska store)
SHOPIFY_STORE_DOMAIN=<store>.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Or, instead of client id/secret, a static Admin API token:
# SHOPIFY_ADMIN_ACCESS_TOKEN=
# Defaults to SHOPIFY_CLIENT_SECRET. Set only if webhooks are signed with another secret.
# SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-10

STORE_SLUG=megaska
STORE_NAME=Megaska

# Long random string; Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Leave unset until the domain cutover. "true" lets search engines index the site.
# SITE_INDEXABLE=true
