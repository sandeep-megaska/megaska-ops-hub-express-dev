{
  "name": "megaska-ops-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "rm -rf generated/prisma node_modules/.prisma && npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "billing:seed-catalog": "node prisma/seed.mjs",
    "billing:verify-catalog": "node scripts/verify-commercial-catalog.mjs",
    "postinstall": "prisma generate",
    "dev:seed:mock-tracking": "ALLOW_MOCK_TRACKING_SEED=true node scripts/dev-seed-mock-tracking.mjs",
    "dev:repair:customer-identity": "node scripts/dev-repair-customer-profile-duplicate.mjs",
    "typecheck": "tsc --noEmit",
    "test:customer-identity-architecture": "node --test scripts/customer-identity-architecture.test.mjs",
    "identity:reconcile": "node scripts/customer-identity-reconcile.mjs",
    "identity:verify": "node scripts/customer-identity-integrity.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "dotenv": "^17.4.2",
    "next": "16.2.2",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^4.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
