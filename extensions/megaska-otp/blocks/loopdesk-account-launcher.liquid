{{ 'loopdesk-account-launcher.css' | asset_url | stylesheet_tag }}

{% assign dashboard_url = block.settings.dashboard_url | default: '/apps/megaska/account' %}
{% assign logged_out_label = block.settings.logged_out_label | default: 'Login' %}
{% assign logged_in_label = block.settings.logged_in_label | default: 'My Account' %}

<div class="ld-account-launcher {{ block.settings.css_class | escape }}" data-loopdesk-account-launcher data-loopdesk-account-launcher-state="loading" {{ block.shopify_attributes }}>
  <a class="ld-account-launcher__link" href="{{ dashboard_url | escape }}" data-loopdesk-account-launcher-action aria-busy="true" aria-label="{{ logged_out_label | escape }}">
    {% if block.settings.show_icon and block.settings.icon_position == 'before' %}<span class="ld-account-launcher__icon" aria-hidden="true">👤</span>{% endif %}
    <span data-loopdesk-account-launcher-label>{{ logged_out_label | escape }}</span>
    {% if block.settings.show_icon and block.settings.icon_position == 'after' %}<span class="ld-account-launcher__icon ld-account-launcher__icon--after" aria-hidden="true">👤</span>{% endif %}
  </a>
  <span class="ld-account-launcher__status" data-loopdesk-account-launcher-status aria-live="polite">Checking account session</span>
  <script type="application/json" data-loopdesk-account-launcher-config>{"loggedOutLabel":{{ logged_out_label | json }},"loggedInLabel":{{ logged_in_label | json }},"dashboardUrl":{{ dashboard_url | json }},"returnUrl":{{ dashboard_url | json }},"loginBehavior":{{ block.settings.login_behavior | json }},"openInSameTab":{{ block.settings.open_in_same_tab | json }},"showIcon":{{ block.settings.show_icon | json }},"hideWhileLoading":{{ block.settings.hide_while_loading | json }}}</script>
</div>
<script src="{{ 'megaska-auth.js' | asset_url }}" defer></script>
<script src="{{ 'loopdesk-account-launcher.js' | asset_url }}" defer></script>

{% schema %}
{"name":"LoopDesk account launcher","target":"section","settings":[{"type":"text","id":"logged_out_label","label":"Logged-out label","default":"Login"},{"type":"text","id":"logged_in_label","label":"Logged-in label","default":"My Account"},{"type":"url","id":"dashboard_url","label":"Dashboard URL","default":"/apps/megaska/account"},{"type":"select","id":"login_behavior","label":"Login behavior","default":"modal","options":[{"value":"modal","label":"Open OTP login"},{"value":"redirect","label":"Redirect with return path"}]},{"type":"checkbox","id":"open_in_same_tab","label":"Open dashboard in same tab","default":true},{"type":"checkbox","id":"show_icon","label":"Show icon","default":true},{"type":"select","id":"icon_position","label":"Icon position","default":"before","options":[{"value":"before","label":"Before label"},{"value":"after","label":"After label"}]},{"type":"text","id":"css_class","label":"CSS class override"},{"type":"checkbox","id":"hide_while_loading","label":"Hide while session state is loading","default":false}]}
{% endschema %}
