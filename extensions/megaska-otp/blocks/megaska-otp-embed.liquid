{% if block.settings.cart_drawer_enabled %}
  <script>
    (function () {
      // Fast-path duplicate of loopdesk-cart-drawer.js's bounce-back check,
      // run inline (no asset fetch, no defer) so a theme-driven redirect to
      // /cart after add-to-cart is corrected as early as physically
      // possible, minimizing the visible flash of the native cart page.
      // loopdesk-cart-drawer.js repeats this same check once it loads, as a
      // fallback in case this inline copy doesn't run for any reason.
      var RETURN_KEY = "loopdeskCartAddReturnTo";
      var REOPEN_KEY = "loopdeskCartAddReopenDrawer";
      var MAX_AGE_MS = 8000;
      function hasCartPath(pathname) {
        return /(?:^|\/)cart\/?$/.test(String(pathname || ""));
      }
      if (!hasCartPath(window.location.pathname)) return;
      var raw;
      try { raw = sessionStorage.getItem(RETURN_KEY); } catch (_error) { return; }
      if (!raw) return;
      try { sessionStorage.removeItem(RETURN_KEY); } catch (_error) {}
      var parsed;
      try { parsed = JSON.parse(raw); } catch (_error) { return; }
      if (!parsed || !parsed.url || !parsed.ts || Date.now() - parsed.ts > MAX_AGE_MS) return;
      var returnUrl;
      try { returnUrl = new URL(parsed.url, window.location.origin); } catch (_error) { return; }
      if (returnUrl.origin !== window.location.origin || hasCartPath(returnUrl.pathname)) return;
      try { sessionStorage.setItem(REOPEN_KEY, "1"); } catch (_error) {}
      window.location.replace(parsed.url);
    })();
  </script>
{% endif %}

{{ 'megaska-otp.css' | asset_url | stylesheet_tag }}
{% if block.settings.cart_drawer_enabled %}
  {{ 'loopdesk-cart-drawer.css' | asset_url | stylesheet_tag }}
{% endif %}

<script>
  window.MEGASKA_SHOP_DOMAIN = {{ shop.permanent_domain | json }};
  // Seed the drawer's brand name from the real Shopify store name so the cart
  // drawer header shows e.g. "Megaska" instead of the raw myshopify domain.
  // loopdesk-cart-drawer.js reads window.LoopDeskConfig.branding once at load,
  // and this inline script runs before that deferred asset, so the seed is in
  // place for the header's first render. (Restores the seed that the removed
  // loopdesk-cart-drawer-embed.liquid block used to provide.)
  window.LoopDeskConfig = Object.assign({}, window.LoopDeskConfig || {}, {
    branding: Object.assign({}, (window.LoopDeskConfig && window.LoopDeskConfig.branding) || {}, {
      merchantName: {{ shop.name | default: shop.permanent_domain | json }},
      storeName: {{ shop.name | default: shop.permanent_domain | json }}
    })
  });
  window.LOOPDESK_CART_DRAWER_CONFIG = Object.assign({}, window.LOOPDESK_CART_DRAWER_CONFIG || {}, {
    enabled: {{ block.settings.cart_drawer_enabled | json }},
    openAfterAddToCart: {{ block.settings.open_after_add_to_cart | json }},
    expressCheckoutButtonEnabled: {{ block.settings.express_checkout_button_enabled | json }},
    viewCartButtonEnabled: {{ block.settings.view_cart_button_enabled | json }},
    shopDomain: {{ shop.permanent_domain | json }}
  });
  (function () {
    var shopDomain = {{ shop.permanent_domain | json }};
    var runtimeConfigReadyDispatched = false;
    function dispatchRuntimeConfigReady() {
      if (runtimeConfigReadyDispatched) return;
      runtimeConfigReadyDispatched = true;
      window.dispatchEvent(
        new CustomEvent("loopdesk:runtime-config-ready", {
          detail: {
            otpModalBranding:
              (window.LoopDeskConfig && window.LoopDeskConfig.otpModalBranding) || null,
            otpCountryPolicy:
              (window.LoopDeskConfig && window.LoopDeskConfig.otpCountryPolicy) || null
          }
        })
      );
    }
    if (window.LoopDeskConfig && window.LoopDeskConfig.otpModalBranding && window.LoopDeskConfig.otpCountryPolicy) {
      dispatchRuntimeConfigReady();
      return;
    }
    if (!shopDomain) return;
    fetch("/apps/loopd2c/api/runtime/config?shop=" + encodeURIComponent(shopDomain) + "&_loopdesk_otp_runtime=" + Date.now(), { credentials: "same-origin" })
      .then(function (response) { return response.ok ? response.json() : null; })
      .then(function (payload) {
        if (!payload || !payload.config) return;
        window.LoopDeskConfig = Object.assign({}, window.LoopDeskConfig || {}, payload.config, {
          otpModalBranding: Object.assign({}, (window.LoopDeskConfig && window.LoopDeskConfig.otpModalBranding) || {}, payload.config.otpModalBranding || {}),
          otpCountryPolicy: payload.config.otpCountryPolicy || (window.LoopDeskConfig && window.LoopDeskConfig.otpCountryPolicy) || null
        });
        dispatchRuntimeConfigReady();
      })
      .catch(function () {});
  })();
</script>

<script src="{{ 'megaska-auth.js' | asset_url }}" defer></script>
<script src="{{ 'megaska-otp.js' | asset_url }}" defer></script>
<script src="{{ 'loopdesk-promotion-pricing.js' | asset_url }}" defer></script>
<script src="{{ 'megaska-express-modal.js' | asset_url }}" defer></script>
<script src="{{ 'loopdesk-checkout-bridge.js' | asset_url }}" defer></script>
<script src="{{ 'loopdesk-buy-now-bridge.js' | asset_url }}" defer></script>
{% if block.settings.cart_drawer_enabled %}
  <script src="{{ 'loopdesk-tier-progress.js' | asset_url }}" defer></script>
  <script src="{{ 'loopdesk-cart-drawer.js' | asset_url }}" defer></script>
{% endif %}
<script src="/apps/loopd2c/loopd2c-exchange-hook.js" defer></script>

{% schema %}
{
  "name": "LoopD2C OTP Embed",
  "target": "body",
  "stylesheet": "loopdesk-cart-drawer.css",
  "javascript": "loopdesk-checkout-bridge.js",
  "settings": [
    {
      "type": "checkbox",
      "id": "cart_drawer_enabled",
      "label": "Enable LoopD2C cart drawer",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_after_add_to_cart",
      "label": "Open drawer after add to cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "express_checkout_button_enabled",
      "label": "Show Express Checkout button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "view_cart_button_enabled",
      "label": "Show View cart fallback",
      "default": true
    }
  ]
}
{% endschema %}
