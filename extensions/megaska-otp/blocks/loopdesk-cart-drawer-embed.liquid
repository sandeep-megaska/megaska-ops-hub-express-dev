{% liquid
  assign loopdesk_cart_drawer_enabled = block.settings.cart_drawer_enabled
  assign loopdesk_open_after_add_to_cart = block.settings.open_after_add_to_cart
  assign loopdesk_express_checkout_enabled = block.settings.express_checkout_button_enabled
  assign loopdesk_view_cart_enabled = block.settings.view_cart_button_enabled
%}

<script src="{{ 'loopdesk-checkout-bridge.js' | asset_url }}" defer></script>

{% if loopdesk_cart_drawer_enabled %}
  {{ 'loopdesk-cart-drawer.css' | asset_url | stylesheet_tag }}

  <script>
    window.LoopDeskConfig = Object.assign({}, window.LoopDeskConfig || {}, {
      branding: Object.assign({}, (window.LoopDeskConfig && window.LoopDeskConfig.branding) || {}, {
        merchantName: {{ shop.name | default: shop.permanent_domain | json }},
        storeName: {{ shop.name | default: shop.permanent_domain | json }}
      }),
      cart: Object.assign({}, (window.LoopDeskConfig && window.LoopDeskConfig.cart) || {}, {
        openAfterAddToCart: {{ loopdesk_open_after_add_to_cart | json }},
        expressCheckoutButtonEnabled: {{ loopdesk_express_checkout_enabled | json }},
        viewCartButtonEnabled: {{ loopdesk_view_cart_enabled | json }}
      }),
      shopDomain: {{ shop.permanent_domain | json }}
    });
    window.LOOPDESK_CART_DRAWER_CONFIG = Object.assign({}, window.LOOPDESK_CART_DRAWER_CONFIG || {}, {
      enabled: {{ loopdesk_cart_drawer_enabled | json }},
      openAfterAddToCart: {{ loopdesk_open_after_add_to_cart | json }},
      expressCheckoutButtonEnabled: {{ loopdesk_express_checkout_enabled | json }},
      viewCartButtonEnabled: {{ loopdesk_view_cart_enabled | json }},
      shopDomain: {{ shop.permanent_domain | json }}
    });
  </script>
  <script>
    (function () {
      var drawerAssetUrl = {{ 'loopdesk-cart-drawer.js' | asset_url | json }};
      var shopDomain = {{ shop.permanent_domain | json }};
      var runtimeUrl = "/apps/megaska/api/runtime/config?shop=" + encodeURIComponent(shopDomain) + "&_loopdesk_runtime=" + Date.now();

      function mergeRuntimeConfig(payload) {
        if (!payload || payload.ok !== true || !payload.config) return;
        window.LoopDeskConfig = Object.assign({}, window.LoopDeskConfig || {}, payload.config, {
          branding: Object.assign({}, (window.LoopDeskConfig && window.LoopDeskConfig.branding) || {}, payload.config.branding || {}),
          labels: Object.assign({}, (window.LoopDeskConfig && window.LoopDeskConfig.labels) || {}, payload.config.labels || {}),
          cart: Object.assign({}, (window.LoopDeskConfig && window.LoopDeskConfig.cart) || {}, payload.config.cart || {}),
          checkout: Object.assign({}, (window.LoopDeskConfig && window.LoopDeskConfig.checkout) || {}, payload.config.checkout || {}),
          promotions: payload.config.promotions || ((window.LoopDeskConfig && window.LoopDeskConfig.promotions) || { rules: [] }),
          shopDomain: shopDomain
        });
        window.LOOPDESK_CART_DRAWER_CONFIG = Object.assign({}, window.LOOPDESK_CART_DRAWER_CONFIG || {}, {
          enabled: window.LoopDeskConfig.enabled,
          drawerMode: window.LoopDeskConfig.cart && window.LoopDeskConfig.cart.drawerMode,
          openAfterAddToCart: window.LoopDeskConfig.cart && window.LoopDeskConfig.cart.openAfterAddToCart,
          expressCheckoutButtonEnabled: window.LoopDeskConfig.cart && window.LoopDeskConfig.cart.expressCheckoutButtonEnabled,
          viewCartButtonEnabled: window.LoopDeskConfig.cart && window.LoopDeskConfig.cart.viewCartButtonEnabled,
          primaryColor: window.LoopDeskConfig.branding && window.LoopDeskConfig.branding.primaryColor,
          checkoutButtonText: window.LoopDeskConfig.labels && window.LoopDeskConfig.labels.expressCheckoutText,
          buttonText: window.LoopDeskConfig.labels && window.LoopDeskConfig.labels.expressCheckoutText,
          showPoweredBy: window.LoopDeskConfig.branding && window.LoopDeskConfig.branding.showPoweredBy,
          shopDomain: shopDomain
        });
      }

      function formatMoney(amount) {
        try {
          return new Intl.NumberFormat(undefined, {
            style: "currency",
            currency: "INR",
            maximumFractionDigits: Number(amount) % 1 === 0 ? 0 : 2
          }).format(amount);
        } catch (_error) {
          return "₹" + Number(amount || 0).toFixed(2);
        }
      }

      function numericPrice(text) {
        var normalized = String(text || "").replace(/[^0-9.,-]/g, "").replace(/,/g, "");
        var value = Number(normalized);
        return Number.isFinite(value) ? value : 0;
      }

      function promotionRule(ruleId) {
        var rules = window.LoopDeskConfig && window.LoopDeskConfig.promotions && window.LoopDeskConfig.promotions.rules;
        if (!Array.isArray(rules)) return null;
        return rules.filter(function (rule) { return String(rule && rule.ruleId || "") === String(ruleId || ""); })[0] || null;
      }

      function offerPrice(originalPrice, rule) {
        var reward = rule && rule.reward || {};
        var value = Number(reward.value || 0);
        if (!Number.isFinite(value)) value = 0;
        if (reward.type === "PERCENTAGE_OFF") return Math.max(0, originalPrice * (1 - value / 100));
        if (reward.type === "FIXED_AMOUNT_OFF") return Math.max(0, originalPrice - value);
        if (reward.type === "FIXED_PRICE") return Math.max(0, value);
        return originalPrice;
      }

      function improveOfferCard(card) {
        var ruleId = card.getAttribute("data-loopdesk-offer-rule");
        var rule = promotionRule(ruleId);
        var priceNode = card.querySelector(".loopdesk-cart-drawer__offer-price");
        if (!rule || !priceNode) return;

        var originalPrice = numericPrice(priceNode.textContent);
        if (!(originalPrice > 0)) return;
        var discountedPrice = offerPrice(originalPrice, rule);
        var signature = String(originalPrice) + ":" + String(discountedPrice);
        if (priceNode.getAttribute("data-loopdesk-benefit-signature") !== signature) {
          priceNode.setAttribute("data-loopdesk-benefit-signature", signature);
          priceNode.innerHTML = '<strong>Get it for ' + formatMoney(discountedPrice) + '</strong><span>Normally <s>' + formatMoney(originalPrice) + '</s></span>';
        }

        var select = card.querySelector("[data-loopdesk-offer-variant]");
        if (!select) return;
        var meaningfulOptions = Array.prototype.filter.call(select.options || [], function (option) {
          var label = String(option.textContent || "").split("—")[0].trim();
          return label && label !== formatMoney(originalPrice) && !/^default title$/i.test(label);
        });
        if ((select.options || []).length <= 1 || meaningfulOptions.length === 0) {
          select.hidden = true;
          select.style.display = "none";
          select.setAttribute("aria-hidden", "true");
        }
      }

      function improveOfferCards() {
        document.querySelectorAll("#loopdesk-cart-drawer-root .loopdesk-cart-drawer__offer").forEach(improveOfferCard);
      }

      function observeOfferCards() {
        improveOfferCards();
        if (!window.MutationObserver) return;
        var observer = new MutationObserver(improveOfferCards);
        observer.observe(document.documentElement, { childList: true, subtree: true });
      }

      function loadDrawerAsset() {
        var script = document.createElement("script");
        script.src = drawerAssetUrl;
        script.defer = true;
        script.addEventListener("load", observeOfferCards, { once: true });
        document.head.appendChild(script);
      }

      if (typeof fetch !== "function") {
        loadDrawerAsset();
        return;
      }

      fetch(runtimeUrl, { credentials: "same-origin", cache: "no-store" })
        .then(function (response) { return response.ok ? response.json() : null; })
        .then(mergeRuntimeConfig)
        .catch(function () {})
        .then(loadDrawerAsset);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "LoopDesk Cart Drawer",
  "target": "body",
  "stylesheet": "loopdesk-cart-drawer.css",
  "javascript": "loopdesk-checkout-bridge.js",
  "settings": [
    {
      "type": "checkbox",
      "id": "cart_drawer_enabled",
      "label": "Enable LoopDesk cart drawer",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_after_add_to_cart",
      "label": "Open drawer after add to cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "express_checkout_button_enabled",
      "label": "Show Express Checkout button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "view_cart_button_enabled",
      "label": "Show View cart fallback",
      "default": true
    }
  ]
}
{% endschema %}