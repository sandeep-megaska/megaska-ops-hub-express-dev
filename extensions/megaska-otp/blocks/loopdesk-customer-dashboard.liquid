{{ 'loopdesk-customer-dashboard.css' | asset_url | stylesheet_tag }}

{% assign mount_id = 'loopdesk-customer-dashboard-root' %}
{% assign account_heading = block.settings.account_heading | default: 'My Account' %}
{% assign dashboard_url = block.settings.dashboard_url | default: '/apps/megaska/account' %}
{% assign support_url = block.settings.support_url | default: '/pages/contact' %}
{% assign continue_shopping_url = block.settings.continue_shopping_url | default: '/collections/all' %}

<div class="ld-account-mount ld-account-mount--{{ block.settings.layout_width | escape }}" style="--ld-account-mount-top: {{ block.settings.top_spacing | default: 24 }}px; --ld-account-mount-bottom: {{ block.settings.bottom_spacing | default: 24 }}px;" {{ block.shopify_attributes }}>
  <div id="{{ mount_id }}" data-loopdesk-customer-dashboard data-loopdesk-mount-mode="inline"><noscript>JavaScript is required to view your LoopDesk customer dashboard.</noscript></div>
  <div class="ld-account-mount__preview" data-loopdesk-theme-editor-preview hidden>
    <strong>LoopDesk Customer Dashboard</strong>
    <p>Login required on storefront. Dashboard will load for verified customers.</p>
  </div>
  <script type="application/json" data-loopdesk-customer-dashboard-config>{"apiUrl":"/apps/megaska/api/customer-dashboard/v1","dashboardUrl":{{ dashboard_url | json }},"supportUrl":{{ support_url | json }},"continueShoppingUrl":{{ continue_shopping_url | json }},"accountLabel":{{ account_heading | json }},"mountMode":"inline","presentation":{"showProfile":{{ block.settings.show_profile_section | json }},"showSummaryCards":{{ block.settings.show_summary_cards | json }},"showRecentOrders":{{ block.settings.show_recent_orders | json }},"showStoreCredit":{{ block.settings.show_store_credit | json }},"showSavedAddress":{{ block.settings.show_saved_address | json }},"showWalletTransactions":{{ block.settings.show_wallet_transactions | json }},"maximumInitialOrdersShown":{{ block.settings.maximum_initial_orders_shown | json }},"layoutWidth":{{ block.settings.layout_width | json }}}}</script>
</div>
<script src="{{ 'megaska-auth.js' | asset_url }}" defer></script>
<script src="{{ 'loopdesk-customer-dashboard.js' | asset_url }}" defer></script>

{% schema %}
{"name":"LoopDesk customer dashboard","target":"section","settings":[{"type":"text","id":"account_heading","label":"Account heading","default":"My Account"},{"type":"url","id":"dashboard_url","label":"Dashboard URL","default":"/apps/megaska/account"},{"type":"url","id":"support_url","label":"Support URL","default":"/pages/contact"},{"type":"url","id":"continue_shopping_url","label":"Continue shopping URL","default":"/collections/all"},{"type":"checkbox","id":"show_profile_section","label":"Show profile section","default":true},{"type":"checkbox","id":"show_summary_cards","label":"Show summary cards","default":true},{"type":"checkbox","id":"show_recent_orders","label":"Show recent orders","default":true},{"type":"checkbox","id":"show_store_credit","label":"Show Store Credit","default":true},{"type":"checkbox","id":"show_saved_address","label":"Show saved address","default":true},{"type":"checkbox","id":"show_wallet_transactions","label":"Show wallet transactions","default":true},{"type":"range","id":"maximum_initial_orders_shown","label":"Maximum initial orders shown","min":1,"max":20,"step":1,"default":10},{"type":"select","id":"layout_width","label":"Layout width","default":"contained","options":[{"value":"contained","label":"Contained"},{"value":"wide","label":"Wide"},{"value":"full","label":"Full width"}]},{"type":"range","id":"top_spacing","label":"Top spacing","min":0,"max":120,"step":4,"unit":"px","default":24},{"type":"range","id":"bottom_spacing","label":"Bottom spacing","min":0,"max":120,"step":4,"unit":"px","default":24}]}
{% endschema %}
