  variantTitleSnapshot  String?
  productHandleSnapshot String?
  submittedAt           DateTime                    @default(now())
  publishedAt           DateTime?
  moderatedAt           DateTime?
  moderatedBy           String?
  rejectionReason       String?
  rejectedAt            DateTime?
  hiddenAt              DateTime?
  deletedAt             DateTime?
  moderationNote        String?
  editedAt              DateTime?
  editCount             Int                         @default(0)
  lastEditedAt          DateTime?
  editVersion           Int                         @default(0)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  shop                  Shop                        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerProfile       CustomerProfile?            @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  reviewRequest         ReviewRequest?              @relation(fields: [reviewRequestId], references: [id], onDelete: SetNull)
  megaskaOrder          MegaskaOrder?               @relation(fields: [megaskaOrderId], references: [id], onDelete: SetNull)
  media                 ProductReviewMedia[]
  merchantReply         ProductReviewMerchantReply?
  editTokens            ProductReviewEditToken[]
  revisions             ProductReviewRevision[]

  // One customer may submit only one review for a purchased order line within a shop; another order line for the same product remains reviewable.
  @@unique([shopId, customerProfileId, shopifyLineItemId])
  @@index([shopId, shopifyProductId, status, publishedAt])
  @@index([shopId, customerProfileId, submittedAt])
  @@index([megaskaOrderId])
  @@index([shopId, status, submittedAt])
}

model ProductReviewMedia {
  id              String                   @id @default(uuid())
  shopId          String
  productReviewId String
  mediaType       ProductReviewMediaType
  status          ProductReviewMediaStatus @default(UPLOADING)
  storageProvider String
  storageKey      String
  publicUrl       String?
  thumbnailUrl    String?
  mimeType        String?
  sizeBytes       Int?
  width           Int?
  height          Int?
  durationSeconds Int?
  altText         String?
  sortOrder       Int                      @default(0)
  approved        Boolean                  @default(false)
  moderationNote  String?
  rejectedAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  shop            Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productReview   ProductReview            @relation(fields: [productReviewId], references: [id], onDelete: Cascade)

  @@unique([storageProvider, storageKey])
  @@unique([productReviewId, sortOrder])
  @@index([productReviewId, sortOrder])
  @@index([shopId, approved])
  @@index([shopId, status])
  @@index([shopId, createdAt])
}

model ProductReviewMerchantReply {
  id              String        @id @default(uuid())
  shopId          String
  productReviewId String        @unique
  body            String
  authorLabel     String        @default("Store team")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productReview   ProductReview @relation(fields: [productReviewId], references: [id], onDelete: Cascade)

  @@index([shopId, productReviewId])
}

model ProductReviewEditToken {
  id              String        @id @default(uuid())
  shopId          String
  productReviewId String
  tokenHash       String        @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())
  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productReview   ProductReview @relation(fields: [productReviewId], references: [id], onDelete: Cascade)

  @@index([shopId, productReviewId, expiresAt])
}

model ProductReviewRevision {
  id              String        @id @default(uuid())
  shopId          String
  productReviewId String
  previousRating  Int
  previousTitle   String?
  previousBody    String?
  nextRating      Int
  nextTitle       String?
  nextBody        String?
  mediaChanges    Json?
  createdAt       DateTime      @default(now())
  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productReview   ProductReview @relation(fields: [productReviewId], references: [id], onDelete: Cascade)

  @@index([shopId, productReviewId, createdAt])
}

model ProductReviewAggregate {
  id               String    @id @default(uuid())
  shopId           String
  shopifyProductId String
  publishedCount   Int       @default(0)
  ratingSum        Int       @default(0)
  averageRating    Decimal   @default(0) @db.Decimal(4, 3)
  rating1Count     Int       @default(0)
  rating2Count     Int       @default(0)
  rating3Count     Int       @default(0)
  rating4Count     Int       @default(0)
  rating5Count     Int       @default(0)
  lastPublishedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, shopifyProductId])
  @@index([shopId, averageRating])
}

enum WalletDirection {
  CREDIT
  DEBIT
}

enum WalletTransactionType {
  COD_REFUND_CREDIT
  MANUAL_CREDIT
  MANUAL_DEBIT
  ADJUSTMENT
  GOODWILL_CREDIT
  CHECKOUT_REDEMPTION
}

enum WalletSourceType {
  ISSUE_REQUEST
  ADMIN_MANUAL
  WALLET_RESERVATION
  REFUND_REQUEST
  CHECKOUT_INTENT
  SHOPIFY_ORDER
}

enum WalletActorType {
  SYSTEM
  ADMIN
}

model WalletAccount {
  id                   String   @id @default(uuid())
  shopId               String
  customerProfileId    String
  currency             String   @default("INR")
  currentBalance       Int      @default(0)
  // Store credit is mirrored to a Shopify gift card so it can be applied natively
  // at Shopify Checkout. One persistent card per customer; the code is generated by
  // us and stored encrypted (Shopify never returns it) for the dashboard/drawer.
  shopifyGiftCardId    String?
  shopifyGiftCardLast4 String?
  giftCardCodeEnc      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  shop         Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer     CustomerProfile     @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  reservations WalletReservation[]

  @@unique([shopId, customerProfileId, currency])
  @@index([shopId])
  @@index([customerProfileId])
}

model WalletTransaction {
  id                String                @id @default(uuid())
  shopId            String
  walletAccountId   String
  customerProfileId String
  direction         WalletDirection
  transactionType   WalletTransactionType
  amount            Int
  currency          String                @default("INR")
  sourceType        WalletSourceType
  sourceId          String?
  sourceReference   String?
  orderNumber       String?
  reason            String?
  adminNote         String?
  createdByType     WalletActorType
  createdById       String?
  createdAt         DateTime              @default(now())

  shop                  Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  walletAccount         WalletAccount   @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  customer              CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  settledRefundRequests RefundRequest[]

  @@unique([sourceType, sourceId, transactionType])
  @@index([customerProfileId, createdAt])
  @@index([walletAccountId, createdAt])
  @@index([sourceType, sourceId])
  @@index([shopId, customerProfileId, createdAt])
  @@index([shopId, sourceType, sourceId])
}

enum WalletReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum WalletReservationSourceFlow {
  CHECKOUT
  BUY_NOW
}

model WalletReservation {
  id                String                      @id @default(uuid())
  shopId            String
  walletAccountId   String
  customerProfileId String
  reservedAmount    Int
  currency          String                      @default("INR")
  status            WalletReservationStatus     @default(ACTIVE)
  discountCode      String?
  shopifyDiscountId String?
  sourceFlow        WalletReservationSourceFlow @default(CHECKOUT)
  cartReference     String?
  checkoutReference String?
  sessionReference  String?
  orderNumber       String?
  shopifyOrderId    String?
  releaseReason     String?
  expiresAt         DateTime
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  walletAccount WalletAccount   @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  customer      CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  shop          Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([customerProfileId, status, expiresAt])
  @@index([walletAccountId, status, expiresAt])
  @@index([discountCode])
  @@index([shopifyOrderId])
  @@index([shopId, status, expiresAt])
}

model RefundRequest {
  id                   String       @id @default(uuid())
  shopId               String
  source               RefundSource
  sourceId             String
  method               RefundMethod @default(COD)
  status               RefundStatus @default(DETAILS_PENDING)
  currency             String       @default("INR")
  amount               Int
  customerProfileId    String?
  orderActionRequestId String?
  walletTransactionId  String?
  shopifyOrderId       String?
  shopifyRefundId      String?
  reason               String?
  customerNote         String?
  adminNote            String?
  metadata             Json?
  detailsSubmittedAt   DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  paidAt               DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  shop               Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerProfile    CustomerProfile?     @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  orderActionRequest OrderActionRequest?  @relation(fields: [orderActionRequestId], references: [id], onDelete: SetNull)
  walletTransaction  WalletTransaction?   @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)
  payoutDetails      RefundPayoutDetails?
  payouts            RefundPayout[]
  events             RefundEvent[]

  @@unique([shopId, source, sourceId])
  @@index([shopId, status, createdAt])
  @@index([customerProfileId, createdAt])
  @@index([orderActionRequestId])
  @@index([walletTransactionId])
}

model RefundPayoutDetails {
  id                String           @id @default(uuid())
  refundRequestId   String           @unique
  rail              RefundPayoutRail
  accountHolderName String?
  bankAccountMasked String?
  bankAccountEnc    String?
  bankIfsc          String?
  upiIdMasked       String?
  upiIdEnc          String?
  phoneMasked       String?
  phoneEnc          String?
  verifiedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  refundRequest RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
}

model RefundPayout {
  id                  String             @id @default(uuid())
  refundRequestId     String
  status              RefundPayoutStatus @default(CREATED)
  provider            String? // manual, razorpay, etc.
  providerReferenceId String?
  amount              Int
  currency            String             @default("INR")
  initiatedAt         DateTime?
  completedAt         DateTime?
  failureReason       String?
  metadata            Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  refundRequest RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)

  @@index([refundRequestId, createdAt])
  @@index([status, createdAt])
}

model RefundEvent {
  id              String          @id @default(uuid())
  refundRequestId String
  actorType       RefundActorType
  actorId         String?
  eventType       String
  fromStatus      RefundStatus?
  toStatus        RefundStatus?
  message         String?
  payload         Json?
  createdAt       DateTime        @default(now())

  refundRequest RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)

  @@index([refundRequestId, createdAt])
}

enum GstDocumentType {
  TAX_INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum GstDocumentStatus {
  DRAFT
  ISSUED
  CANCELLED
  VOID
  FAILED
}

enum GstNumberingStrategy {
  FINANCIAL_YEAR_SEQUENCE
  CALENDAR_YEAR_SEQUENCE
  MONTHLY_SEQUENCE
  MANUAL
}

enum GstSupplyType {
  B2B
  B2C
  EXPORT
  SEZ_WITH_PAYMENT
  SEZ_WITHOUT_PAYMENT
  DEEMED_EXPORT
}

model GstSettings {
  id                    String               @id @default(uuid())
  shopId                String
  legalName             String
  tradeName             String?
  gstin                 String
  pan                   String?
  stateCode             String
  invoicePrefix         String
  creditNotePrefix      String
  debitNotePrefix       String
  invoiceNumberStrategy GstNumberingStrategy
  numberingConfig       Json?
  defaultCurrency       String               @default("INR")
  priceIncludesTax      Boolean              @default(true)
  einvoiceEnabled       Boolean              @default(false)
  autoGenerateOnOrderCreate Boolean          @default(false)
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  documents          GstDocument[]
  counters           GstCounter[]
  exports            GstExport[]
  reconciliationRuns GstReconciliationRun[]
  auditLogs          GstAuditLog[]
  orderImports       GstOrderImport[]
  invoiceTemplates   GstInvoiceTemplate[]
  reportRuns         GstReportRun[]
  shop               Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // GSTIN is unique per shop, not globally: a business migrating from another
  // GST app (or running multiple stores) legitimately reuses one GSTIN, and the
  // legacy shared DB already carries rows under other shops.
  @@unique([shopId, gstin])
  @@index([shopId])
}

model GstCounter {
  id            String          @id @default(uuid())
  gstSettingsId String
  documentType  GstDocumentType
  financialYear String
  lastNumber    Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  gstSettings GstSettings @relation(fields: [gstSettingsId], references: [id], onDelete: Cascade)

  @@unique([gstSettingsId, documentType, financialYear])
  @@index([gstSettingsId, documentType])
}

model GstDocument {
  id             String            @id @default(uuid())
  documentType   GstDocumentType
  status         GstDocumentStatus
  documentNumber String            @unique
  documentDate   DateTime
  gstSettingsId  String
  gstSettings    GstSettings       @relation(fields: [gstSettingsId], references: [id])

  shopId         String
  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)

  shopifyOrderId     String?
  shopifyOrderName   String?
  sourceOrderId      String?
  sourceOrderNumber  String?
  sourceReference    String?
  customerProfileId  String?
  customer           CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  originalDocumentId String?
  originalDocument   GstDocument?     @relation("GstDocToOriginal", fields: [originalDocumentId], references: [id])
  derivedNotes       GstDocument[]    @relation("GstDocToOriginal")

  supplyType             GstSupplyType
  placeOfSupplyStateCode String
  isInterstate           Boolean
  currency               String        @default("INR")

  taxableAmount Decimal @db.Decimal(14, 2)
  cgstAmount    Decimal @db.Decimal(14, 2)
  sgstAmount    Decimal @db.Decimal(14, 2)
  igstAmount    Decimal @db.Decimal(14, 2)
  cessAmount    Decimal @db.Decimal(14, 2)
  totalAmount   Decimal @db.Decimal(14, 2)

  pdfFileUrl   String?
  jsonSnapshot Json
  metadata     Json?
  issuedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines       GstDocumentLine[]
  exportItems GstExportItem[]
  auditLogs   GstAuditLog[]
  legacyLinks GstLegacyDocument[]

  @@index([gstSettingsId])
  @@index([shopId])
  @@index([customerProfileId])
  @@index([sourceOrderId])
  @@index([sourceOrderNumber])
  @@index([originalDocumentId])
  @@index([status, documentDate])
}

model GstDocumentLine {
  id            String   @id @default(uuid())
  gstDocumentId String
  shopId        String
  lineNumber    Int
  description   String
  hsnOrSac      String?
  quantity      Decimal  @db.Decimal(14, 3)
  unit          String?
  unitPrice     Decimal  @db.Decimal(14, 2)
  discount      Decimal  @default(0) @db.Decimal(14, 2)
  taxableAmount Decimal  @db.Decimal(14, 2)
  taxRate       Decimal  @db.Decimal(5, 2)
  cgstAmount    Decimal  @db.Decimal(14, 2)
  sgstAmount    Decimal  @db.Decimal(14, 2)
  igstAmount    Decimal  @db.Decimal(14, 2)
  cessAmount    Decimal  @db.Decimal(14, 2)
  lineTotal     Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  document GstDocument @relation(fields: [gstDocumentId], references: [id], onDelete: Cascade)
  shop     Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([gstDocumentId, lineNumber])
  @@index([gstDocumentId])
  @@index([shopId])
}

model GstParty {
  id                String   @id @default(uuid())
  gstin             String?  @unique
  legalName         String
  tradeName         String?
  customerProfileId String?
  email             String?
  phone             String?
  stateCode         String?
  countryCode       String   @default("IN")
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer        CustomerProfile?    @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  auditLogs       GstAuditLog[]
  legacyDocuments GstLegacyDocument[]

  @@index([customerProfileId])
  @@index([legalName])
}

model GstExport {
  id              String    @id @default(uuid())
  gstSettingsId   String
  exportType      String
  periodStart     DateTime
  periodEnd       DateTime
  status          String
  storageUrl      String?
  checksum        String?
  filters         Json?
  generatedByType String?
  generatedById   String?
  generatedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  gstSettings GstSettings     @relation(fields: [gstSettingsId], references: [id], onDelete: Cascade)
  items       GstExportItem[]
  auditLogs   GstAuditLog[]

  @@unique([gstSettingsId, exportType, periodStart, periodEnd])
  @@index([gstSettingsId, periodStart, periodEnd])
  @@index([status, createdAt])
}

model GstExportItem {
  id             String           @id @default(uuid())
  gstExportId    String
  gstDocumentId  String?
  rowNumber      Int
  documentType   GstDocumentType?
  documentNumber String?
  documentDate   DateTime?
  status         String
  payload        Json
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  gstExport   GstExport    @relation(fields: [gstExportId], references: [id], onDelete: Cascade)
  gstDocument GstDocument? @relation(fields: [gstDocumentId], references: [id], onDelete: SetNull)

  @@unique([gstExportId, rowNumber])
  @@index([gstDocumentId])
  @@index([status])
  @@index([documentType, documentDate])
}

model GstReconciliationRun {
  id                   String    @id @default(uuid())
  gstSettingsId        String
  periodStart          DateTime
  periodEnd            DateTime
  sourceSystem         String
  status               String
  matchedCount         Int       @default(0)
  mismatchedCount      Int       @default(0)
  missingInBooksCount  Int       @default(0)
  missingInPortalCount Int       @default(0)
  summary              Json?
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  gstSettings GstSettings   @relation(fields: [gstSettingsId], references: [id], onDelete: Cascade)
  auditLogs   GstAuditLog[]

  @@index([gstSettingsId, periodStart, periodEnd])
  @@index([status, startedAt])
}

model GstAuditLog {
  id                  String   @id @default(uuid())
  gstSettingsId       String?
  gstDocumentId       String?
  gstPartyId          String?
  gstExportId         String?
  reconciliationRunId String?
  action              String
  actorType           String
  actorId             String?
  previousState       Json?
  nextState           Json?
  metadata            Json?
  createdAt           DateTime @default(now())

  gstSettings       GstSettings?          @relation(fields: [gstSettingsId], references: [id], onDelete: SetNull)
  gstDocument       GstDocument?          @relation(fields: [gstDocumentId], references: [id], onDelete: SetNull)
  gstParty          GstParty?             @relation(fields: [gstPartyId], references: [id], onDelete: SetNull)
  gstExport         GstExport?            @relation(fields: [gstExportId], references: [id], onDelete: SetNull)
  reconciliationRun GstReconciliationRun? @relation(fields: [reconciliationRunId], references: [id], onDelete: SetNull)

  @@index([gstDocumentId, createdAt])
  @@index([gstPartyId, createdAt])
  @@index([gstExportId, createdAt])
  @@index([reconciliationRunId, createdAt])
  @@index([action, createdAt])
}

model GstLegacyDocument {
  id                   String             @id @default(uuid())
  sourceSystem         String
  legacyDocumentId     String
  legacyDocumentNumber String?
  documentType         GstDocumentType?
  documentStatus       GstDocumentStatus?
  gstDocumentId        String?
  gstPartyId           String?
  payload              Json?
  importedAt           DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  gstDocument GstDocument? @relation(fields: [gstDocumentId], references: [id], onDelete: SetNull)
  gstParty    GstParty?    @relation(fields: [gstPartyId], references: [id], onDelete: SetNull)

  @@unique([sourceSystem, legacyDocumentId])
  @@index([legacyDocumentNumber])
  @@index([gstDocumentId])
  @@index([gstPartyId])
}

model GstHsnCode {
  id            String    @id @default(uuid())
  hsnCode       String    @unique
  description   String
  isService     Boolean   @default(false)
  isActive      Boolean
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  slabMaps    GstHsnSlabMap[]
  productMaps GstProductTaxMap[]
}

model GstTaxSlab {
  id            String    @id @default(uuid())
  slabCode      String    @unique
  taxRate       Decimal   @db.Decimal(5, 2)
  cessRate      Decimal   @default(0) @db.Decimal(5, 2)
  isActive      Boolean
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  hsnMaps     GstHsnSlabMap[]
  productMaps GstProductTaxMap[]
}

model GstHsnSlabMap {
  id            String    @id @default(uuid())
  hsnId         String
  slabId        String
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  priority      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  hsn  GstHsnCode @relation(fields: [hsnId], references: [id], onDelete: Cascade)
  slab GstTaxSlab @relation(fields: [slabId], references: [id], onDelete: Cascade)

  @@unique([hsnId, slabId, effectiveFrom, effectiveTo])
  @@index([hsnId])
  @@index([slabId])
  @@index([effectiveFrom, effectiveTo])
}

model GstProductTaxMap {
  id               String    @id @default(uuid())
  shopId           String
  shopifyProductId String
  shopifyVariantId String?
  hsnId            String
  slabId           String
  source           String
  status           String
  effectiveFrom    DateTime? @db.Date
  effectiveTo      DateTime? @db.Date
  lastValidatedAt  DateTime?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hsn  GstHsnCode @relation(fields: [hsnId], references: [id], onDelete: Restrict)
  slab GstTaxSlab @relation(fields: [slabId], references: [id], onDelete: Restrict)
  shop Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, shopifyProductId, shopifyVariantId])
  @@index([shopId])
  @@index([shopifyProductId])
  @@index([shopifyVariantId])
  @@index([status])
}

model GstSkuTaxMap {
  id        String   @id @default(uuid())
  shopId    String
  sku       String?
  styleCode String?
  hsnCode   String
  taxRate   Decimal  @db.Decimal(5, 2)
  cessRate  Decimal  @default(0) @db.Decimal(5, 2)
  // Optional per-SKU price-cap slab. When priceCapThreshold is set, a line whose
  // per-unit price exceeds it uses taxRateAbove/cessRateAbove; at or below the
  // threshold (and whenever the threshold is null) taxRate/cessRate apply. This
  // models GST slabs that switch on per-piece sale value (e.g. apparel/footwear)
  // without hardcoding the threshold.
  priceCapThreshold Decimal? @db.Decimal(14, 2)
  taxRateAbove      Decimal? @db.Decimal(5, 2)
  cessRateAbove     Decimal  @default(0) @db.Decimal(5, 2)
  source    String   @default("BULK_CSV")
  status    String   @default("ACTIVE")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, sku])
  @@index([shopId, styleCode])
  @@index([status])
}

model GstOrderImport {
  id                String    @id @default(uuid())
  shopId            String
  gstSettingsId     String
  shopifyOrderId    String
  shopifyOrderName  String
  orderCreatedAt    DateTime
  orderCurrency     String
  orderSubtotal     Decimal   @db.Decimal(14, 2)
  orderTaxTotal     Decimal   @db.Decimal(14, 2)
  orderGrandTotal   Decimal   @db.Decimal(14, 2)
  shippingStateCode String?
  billingStateCode  String?
  importStatus      String
  eligibilityStatus String
  readinessErrors   Json      @default("[]")
  snapshot          Json
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  gstSettings GstSettings          @relation(fields: [gstSettingsId], references: [id], onDelete: Cascade)
  shop        Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  lines       GstOrderImportLine[]

  @@unique([shopId, shopifyOrderId])
  @@index([shopId])
  @@index([gstSettingsId])
  @@index([shopifyOrderName])
  @@index([importStatus, eligibilityStatus])
  @@index([orderCreatedAt])
}

model GstOrderImportLine {
  id                String   @id @default(uuid())
  gstOrderImportId  String
  lineNumber        Int
  shopifyLineItemId String?
  shopifyProductId  String?
  shopifyVariantId  String?
  title             String
  sku               String?
  quantity          Decimal  @db.Decimal(14, 3)
  unitPrice         Decimal  @db.Decimal(14, 2)
  discount          Decimal  @default(0) @db.Decimal(14, 2)
  taxableAmount     Decimal  @db.Decimal(14, 2)
  mappedHsnCode     String?
  mappedTaxRate     Decimal? @db.Decimal(5, 2)
  mappedCessRate    Decimal? @db.Decimal(5, 2)
  mappingStatus     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orderImport GstOrderImport @relation(fields: [gstOrderImportId], references: [id], onDelete: Cascade)

  @@unique([gstOrderImportId, lineNumber])
  @@index([gstOrderImportId])
  @@index([shopifyProductId])
  @@index([shopifyVariantId])
  @@index([mappingStatus])
}

model GstInvoiceTemplate {
  id              String   @id @default(uuid())
  gstSettingsId   String
  templateName    String
  isActive        Boolean
  isDefault       Boolean
  headerText      String?
  footerText      String?
  declarationText String?
  notesText       String?
  logoFileUrl     String?
  themeConfig     Json?
  version         Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gstSettings GstSettings @relation(fields: [gstSettingsId], references: [id], onDelete: Cascade)

  @@index([gstSettingsId, isActive])
  @@index([gstSettingsId, isDefault])
}

model GstReportRun {
  id            String    @id @default(uuid())
  gstSettingsId String
  reportType    String
  periodStart   DateTime
  periodEnd     DateTime
  format        String
  status        String
  filters       Json?
  fileUrl       String?
  checksum      String?
  rowCount      Int
  generatedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  gstSettings GstSettings @relation(fields: [gstSettingsId], references: [id], onDelete: Cascade)

  @@index([gstSettingsId, reportType, periodStart, periodEnd])
  @@index([status, createdAt])
}

model ExchangePaymentInvoice {
  id                 String                       @id @default(uuid())
  requestPaymentId   String                       @unique
  requestId          String
  invoiceNumber      String                       @unique
  invoiceDate        DateTime
  invoiceStatus      ExchangePaymentInvoiceStatus @default(GENERATED)
  customerName       String
  customerPhone      String?
  customerEmail      String?
  orderNumber        String
  description        String
  amountPaise        Int
  taxableAmountPaise Int
  gstRatePercent     Float
  cgstPaise          Int                          @default(0)
  sgstPaise          Int                          @default(0)
  igstPaise          Int                          @default(0)
  totalPaise         Int
  currency           String                       @default("INR")
  pdfUrl             String?
  htmlSnapshot       String?
  textSnapshot       String?
  sentAt             DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  requestPayment RequestPayment     @relation(fields: [requestPaymentId], references: [id], onDelete: Cascade)
  request        OrderActionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

enum ExpressCheckoutIntentStatus {
  CREATED
  CUSTOMER_AUTHENTICATED
  CART_SNAPSHOT_LOCKED
  ADDRESS_CAPTURED
  DISCOUNT_APPLIED
  PAYMENT_METHOD_SELECTED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  ORDER_CREATING
  ORDER_CREATED
  FAILED
  EXPIRED
  CANCELLED
  INITIATED
  SESSION_VERIFIED
  ADDRESS_COMPLETED
  DELIVERY_VALIDATED
  COUPON_APPLIED
  PAYMENT_SELECTED
  DRAFT_ORDER_CREATED
  PAYMENT_SUCCESS
  ORDER_COMPLETED
  PAYMENT_FAILED
  PAYMENT_CANCELLED
  ABANDONED
}

enum ExpressCheckoutPaymentMethod {
  PREPAID
  COD
}

enum ExpressCheckoutPaymentStatus {
  NOT_REQUIRED
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum ExpressCheckoutPaymentPurpose {
  ORDER_PREPAID
  COD_ADVANCE
}

enum ExpressCheckoutDiscountType {
  MANUAL_CODE
  AUTOMATIC
}

enum ShopifyCheckoutPricingSnapshotStatus {
  CURRENT
  INVALIDATED
}

enum CheckoutRecoveryType {
  CHECKOUT_ABANDONMENT
  PAYMENT_ABANDONMENT
}

enum CheckoutRecoveryTokenStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

model ExpressCheckoutIntent {
  id                    String                        @id @default(uuid())
  shopId                String
  customerProfileId     String?
  sessionTokenHash      String?
  status                ExpressCheckoutIntentStatus   @default(CREATED)
  phoneSnapshot         String?
  cartToken             String?
  shopifyCartId         String?
  cartSnapshot          Json?
  subtotalAmountPaise   Int                           @default(0)
  discountAmountPaise   Int                           @default(0)
  shippingAmountPaise   Int                           @default(0)
  codFeeAmountPaise     Int                           @default(0)
  prepaidDiscountAmountPaise Int                      @default(0)
  totalAmountPaise      Int                           @default(0)
  currency              String                        @default("INR")
  selectedPaymentMethod ExpressCheckoutPaymentMethod?
  expiresAt             DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  paymentPendingAt      DateTime?
  abandonedAt           DateTime?
  completedAt           DateTime?
  lastTransitionAt      DateTime?

  addressSnapshots ExpressCheckoutAddressSnapshot[]
  discounts        ExpressCheckoutDiscount[]
  payments         ExpressCheckoutPayment[]
  orderLink        ExpressCheckoutOrderLink?
  recoveryTokens   CheckoutRecoveryToken[]
  pricingSnapshots ShopifyCheckoutPricingSnapshot[]

  @@unique([shopId, id])
  @@index([shopId, id])
  @@index([shopId, customerProfileId])
  @@index([shopId, status])
  @@index([shopId, sessionTokenHash])
  @@index([shopId, cartToken])
  @@index([shopId, shopifyCartId])
}

enum CheckoutFunnelEventType {
  CART_ADD
  DRAWER_OPEN
  EXPRESS_CLICK
  OTP_OPEN
  OTP_SUCCESS
  MODAL_OPEN
}

enum CheckoutFunnelSource {
  DRAWER
  CART_PAGE
  PRODUCT
  UNKNOWN
}

enum CheckoutFunnelDevice {
  MOBILE
  DESKTOP
  UNKNOWN
}

// Captures the pre-intent express-checkout funnel steps (add-to-cart, drawer
// open, express-checkout click, OTP login) that are otherwise only client-side.
// Post-intent steps live on ExpressCheckoutIntent; these join to it by
// cartToken / customerProfileId / funnelSessionId. Write-only from the
// storefront beacon; never carries raw session tokens (only a hash).
model CheckoutFunnelEvent {
  id                      String                  @id @default(uuid())
  shopId                  String
  funnelSessionId         String
  eventType               CheckoutFunnelEventType
  source                  CheckoutFunnelSource?
  device                  CheckoutFunnelDevice    @default(UNKNOWN)
  customerProfileId       String?
  sessionTokenHash        String?
  phoneSnapshot           String?
  cartToken               String?
  cartValuePaise          Int?
  expressCheckoutIntentId String?
  metadata                Json?
  occurredAt              DateTime                @default(now())
  createdAt               DateTime                @default(now())

  @@index([shopId, occurredAt])
  @@index([shopId, eventType, occurredAt])
  @@index([shopId, funnelSessionId])
  @@index([shopId, customerProfileId])
}

model ShopifyCheckoutPricingSnapshot {
  id                     String                               @id @default(uuid())
  publicId               String                               @unique @default(uuid())
  shopId                 String
  checkoutIntentId       String
  shopifyDraftOrderId    String?
  source                 String                               @default("SHOPIFY")
  status                 ShopifyCheckoutPricingSnapshotStatus @default(CURRENT)
  currency               String?
  subtotalMinor          Int?
  discountsMinor         Int?
  shippingMinor          Int?
  totalTaxMinor          Int?
  totalPayableMinor      Int?
  taxesIncluded          Boolean?
  taxSummary             Json?
  cartFingerprint        String?
  addressFingerprint     String?
  shippingFingerprint    String?
  discountFingerprint    String?
  storeCreditFingerprint String?
  refreshReason          String?
  invalidatedAt          DateTime?
  invalidationReason     String?
  authoritativeAt        DateTime?
  createdAt              DateTime                             @default(now())
  updatedAt              DateTime                             @updatedAt

  shop           Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  checkoutIntent ExpressCheckoutIntent @relation(fields: [shopId, checkoutIntentId], references: [shopId, id], onDelete: Cascade)

  @@unique([shopId, checkoutIntentId])
  @@index([shopId, status])
  @@index([shopId, shopifyDraftOrderId])
}

model CheckoutRecoveryToken {
  id                String                      @id @default(uuid())
  shopId            String
  checkoutIntentId  String
  customerProfileId String?
  tokenHash         String                      @unique
  recoveryType      CheckoutRecoveryType
  status            CheckoutRecoveryTokenStatus @default(ACTIVE)
  expiresAt         DateTime
  clickedAt         DateTime?
  usedAt            DateTime?
  revokedAt         DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  metadata          Json?

  shop            Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  checkoutIntent  ExpressCheckoutIntent @relation(fields: [checkoutIntentId], references: [id], onDelete: Cascade)
  customerProfile CustomerProfile?      @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)

  @@index([shopId, tokenHash, status])
  @@index([shopId, checkoutIntentId])
}

model ExpressCheckoutAddressSnapshot {
  id                String   @id @default(uuid())
  shopId            String
  intentId          String
  customerProfileId String?
  name              String
  phone             String
  email             String?
  address1          String
  address2          String?
  city              String
  province          String
  country           String   @default("India")
  zip               String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  intent ExpressCheckoutIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([shopId, id])
  @@index([shopId, intentId])
  @@index([shopId, customerProfileId])
}

model ExpressCheckoutDiscount {
  id                  String                      @id @default(uuid())
  shopId              String
  intentId            String
  type                ExpressCheckoutDiscountType
  code                String?
  title               String?
  discountAmountPaise Int                         @default(0)
  rawShopifyPayload   Json?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  intent ExpressCheckoutIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([shopId, id])
  @@index([shopId, intentId])
  @@index([shopId, code])
}

model ExpressCheckoutPayment {
  id                    String                        @id @default(uuid())
  shopId                String
  intentId              String
  method                ExpressCheckoutPaymentMethod
  purpose               ExpressCheckoutPaymentPurpose @default(ORDER_PREPAID)
  status                ExpressCheckoutPaymentStatus  @default(PENDING)
  amountPaise           Int                           @default(0)
  currency              String                        @default("INR")
  verifiedAt            DateTime?
  providerAmountPaise   Int?
  providerCurrency      String?
  razorpayOrderId       String?
  razorpayPaymentId     String?
  razorpaySignatureHash String?
  failureReason         String?
  rawGatewayPayload     Json?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  intent ExpressCheckoutIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@unique([shopId, razorpayOrderId])
  @@unique([shopId, razorpayPaymentId])
  @@index([shopId, id])
  @@index([shopId, intentId])
  @@index([shopId, status])
}

model ExpressCheckoutOrderLink {
  id                String   @id @default(uuid())
  shopId            String
  intentId          String   @unique
  draftOrderId      String?
  draftOrderName    String?
  shopifyOrderId    String?
  shopifyOrderName  String?
  financialStatus   String?
  fulfillmentStatus String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  intent ExpressCheckoutIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@unique([shopId, intentId])
  @@index([shopId, id])
  @@index([shopId, intentId])
  @@index([shopId, shopifyOrderId])
}

model ShopModuleConfig {
  id        String   @id @default(uuid())
  shopId    String
  moduleKey String
  enabled   Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, moduleKey])
  @@index([shopId])
  @@index([moduleKey, enabled])
}

model ShopProxyRoute {
  id           String   @id @default(uuid())
  shopId       String
  routeKey     String
  proxyPrefix  String
  proxySubpath String
  targetModule String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, routeKey])
  @@index([shopId, isActive])
  @@index([targetModule, isActive])
}

model ShopInstallationEvent {
  id        String   @id @default(uuid())
  shopId    String
  eventType String
  scopes    String?
  payload   Json?
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([eventType, createdAt])
}
