generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CustomerProfile {
  id                 String    @id @default(uuid())
  shopId             String?
  phoneE164          String?
  fullName           String?
  firstName          String?
  lastName           String?
  email              String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  stateProvince      String?
  postalCode         String?
  countryRegion      String?
  shopifyCustomerId  String?
  phoneVerifiedAt    DateTime?
  profileCompletedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  sessions            AuthSession[]
  otpChallenges       OTPChallenge[]
  orderActionRequests OrderActionRequest[]
  megaskaOrders       MegaskaOrder[]
  walletAccounts      WalletAccount[]
  walletTransactions  WalletTransaction[]
  walletReservations  WalletReservation[]
  gstDocuments        GstDocument[]
  gstParties          GstParty[]
  refundRequests      RefundRequest[]
  codAdvanceIntents   CodAdvanceIntent[]
  recoveryTokens      CheckoutRecoveryToken[]
  reviewRequests      ReviewRequest[]
  productReviews      ProductReview[]
  identityPlans       CustomerIdentityReconciliationPlan[]
  identityAudits      CustomerIdentityReconciliationAudit[]
  emailVerificationChallenges EmailVerificationChallenge[]

  @@unique([shopId, shopifyCustomerId])
  @@index([shopId])
  @@index([shopId, phoneE164])
  @@index([shopId, email])
}

model Shop {
  id                       String    @id @default(uuid())
  shopDomain               String    @unique
  accessToken              String?
  storefrontAccessToken    String?
  scopes                   String?
  isActive                 Boolean   @default(true)
  installedAt              DateTime?
  uninstalledAt            DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  myshopifyDomain          String?   @unique
  primaryDomain            String?
  shopName                 String?
  accessTokenEncrypted     String?
  storefrontTokenEncrypted String?
  appProxyPrefix           String?
  appProxySubpath          String?
  appProxyEnabled          Boolean   @default(false)
  installationStatus       String    @default("DEV")
  checkoutEnabled          Boolean   @default(false)
  tokenExpiresAt           DateTime?
  tokenRotationRequiredAt  DateTime?

  customers                     CustomerProfile[]
  otpChallenges                 OTPChallenge[]
  orderActionRequests           OrderActionRequest[]
  megaskaOrders                 MegaskaOrder[]
  walletReservations            WalletReservation[]
  walletAccounts                WalletAccount[]
  walletTransactions            WalletTransaction[]
  gstSettings                   GstSettings[]
  gstProductTaxMaps             GstProductTaxMap[]
  gstSkuTaxMaps                 GstSkuTaxMap[]
  gstOrderImports               GstOrderImport[]
  gstDocuments                  GstDocument[]
  gstDocumentLines              GstDocumentLine[]
  refundRequests                RefundRequest[]
  codAdvanceSettings            CodAdvanceSettings[]
  codAdvanceIntents             CodAdvanceIntent[]
  moduleConfigs                 ShopModuleConfig[]
  proxyRoutes                   ShopProxyRoute[]
  installationEvents            ShopInstallationEvent[]
  recoveryTokens                CheckoutRecoveryToken[]
  promotionRules                PromotionRule[]
  promotionOrderTiers           PromotionOrderTier[]
  promotionAuditLogs            PromotionAuditLog[]
  promotionRuntimeSyncState     PromotionRuntimeSyncState?
  merchantNotificationSettings  MerchantNotificationSettings?
  merchantOtpSettings           MerchantOtpSettings?
  merchantUsageEvents           MerchantUsageEvent[]
  merchantSubscription          MerchantSubscription?
  merchantBillingPeriods        MerchantBillingPeriod[]
  merchantRatedUsages           MerchantRatedUsage[]
  billingProviderSubmissions    MerchantBillingProviderSubmission[]
  billingReconciliations        MerchantBillingReconciliation[]
  merchantPlanChanges           MerchantPlanChange[]
  reviewSettings                ReviewSettings?
  reviewRequests                ReviewRequest[]
  productReviews                ProductReview[]
  productReviewMedia            ProductReviewMedia[]
  productReviewReplies          ProductReviewMerchantReply[]
  reviewEditTokens              ProductReviewEditToken[]
  reviewRequestDeliveryAttempts ProductReviewRequestDeliveryAttempt[]
  productReviewRevisions        ProductReviewRevision[]
  productReviewAggregates       ProductReviewAggregate[]
  identityReconciliationPlans   CustomerIdentityReconciliationPlan[]
  identityReconciliationAudits  CustomerIdentityReconciliationAudit[]
  identityMerges                CustomerIdentityMerge[]
  checkoutPricingSnapshots      ShopifyCheckoutPricingSnapshot[]
  emailVerificationChallenges   EmailVerificationChallenge[]
}

model EmailVerificationChallenge {
  id                         String    @id @default(uuid())
  shopId                     String
  customerProfileId          String
  email                      String
  candidateShopifyCustomerId String
  candidateFirstName         String?
  candidateLastName          String?
  codeHash                   String
  status                     String    @default("pending") // pending, verified, failed, expired
  attemptsCount              Int       @default(0)
  expiresAt                  DateTime
  verifiedAt                 DateTime?
  createdAt                  DateTime  @default(now())

  shop            Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([shopId, customerProfileId, status, createdAt])
}

enum CustomerIdentityReconciliationStatus {
  DRAFT
  APPROVED
  APPLYING
  APPLIED
  FAILED
  CANCELLED
}

model CustomerIdentityReconciliationPlan {
  id                         String                               @id @default(uuid())
  shopId                     String
  canonicalCustomerProfileId String
  sourceCustomerProfileIds   String[]
  classification             String
  status                     CustomerIdentityReconciliationStatus @default(DRAFT)
  createdBy                  String
  approvedBy                 String?
  approvedAt                 DateTime?
  appliedAt                  DateTime?
  checksum                   String                               @unique
  sourceStateChecksum        String
  plan                       Json
  failureReason              String?
  createdAt                  DateTime                             @default(now())
  updatedAt                  DateTime                             @updatedAt

  shop      Shop                                  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  canonical CustomerProfile                       @relation(fields: [canonicalCustomerProfileId], references: [id], onDelete: Restrict)
  merges    CustomerIdentityMerge[]
  audits    CustomerIdentityReconciliationAudit[]

  @@index([shopId, status, createdAt])
}

model CustomerIdentityMerge {
  id                      String   @id @default(uuid())
  shopId                  String
  sourceCustomerProfileId String   @unique
  targetCustomerProfileId String
  planId                  String
  mergedAt                DateTime @default(now())

  shop Shop                               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  plan CustomerIdentityReconciliationPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([shopId, targetCustomerProfileId])
  @@index([planId])
}

model CustomerIdentityReconciliationAudit {
  id                         String   @id @default(uuid())
  planId                     String
  shopId                     String
  canonicalCustomerProfileId String
  sourceCustomerProfileIds   String[]
  classification             String
  affectedRecordCounts       Json
  result                     String
  failureReason              String?
  actor                      String
  beforeIntegrityHash        String
  afterIntegrityHash         String?
  createdAt                  DateTime @default(now())

  plan      CustomerIdentityReconciliationPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  shop      Shop                               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  canonical CustomerProfile                    @relation(fields: [canonicalCustomerProfileId], references: [id], onDelete: Restrict)

  @@index([shopId, createdAt])
  @@index([planId])
}

enum MerchantUsageType {
  OTP
  EMAIL
  SMS
  WHATSAPP
  AI
  DELIVERY_LOOKUP
  CHECKOUT_TRANSACTION
}

enum MerchantUsageAction {
  OTP_REQUEST
  EMAIL_SEND
  SMS_SEND
  WHATSAPP_SEND
  AI_REQUEST
  DELIVERY_LOOKUP
  CHECKOUT_TRANSACTION
}

enum MerchantUsageProvider {
  PLATFORM_TWILIO
  PLATFORM_RESEND
  PLATFORM_MSG91
  MERCHANT_TWILIO
  MERCHANT_RESEND
  MERCHANT_MSG91
  INTERNAL
}

enum MerchantUsageStatus {
  RECORDED
  REVERSED
  EXCLUDED
}

enum MerchantUsageBillingStatus {
  UNRATED
  PENDING
  INCLUDED
  BILLABLE
  SUBMITTED
  BILLED
  FAILED
  EXCLUDED
}

model BillableFeature {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pricingPlanFeatures PricingPlanFeature[]
  merchantRatedUsages MerchantRatedUsage[]
}

model PricingPlan {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  description      String?
  monthlyBasePrice Decimal  @db.Decimal(18, 6)
  currency         String   @default("INR")
  active           Boolean  @default(true)
  tierRank         Int      @default(0)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  features                PricingPlanFeature[]
  merchantSubscriptions   MerchantSubscription[]
  merchantRatedUsages     MerchantRatedUsage[]
  merchantPlanChangesFrom MerchantPlanChange[]   @relation("PlanChangeFrom")
  merchantPlanChangesTo   MerchantPlanChange[]   @relation("PlanChangeTo")
}

model PricingPlanFeature {
  id                String   @id @default(uuid())
  pricingPlanId     String
  billableFeatureId String
  includedQuantity  Decimal  @default(0) @db.Decimal(18, 6)
  overageUnitPrice  Decimal  @default(0) @db.Decimal(18, 6)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pricingPlan     PricingPlan     @relation(fields: [pricingPlanId], references: [id], onDelete: Cascade)
  billableFeature BillableFeature @relation(fields: [billableFeatureId], references: [id], onDelete: Restrict)

  @@unique([pricingPlanId, billableFeatureId])
  @@index([billableFeatureId])
}

enum MerchantBillingPeriodStatus {
  OPEN
  RATING
  RATED
  CLOSED
  VOID
}

enum MerchantSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum BillingProvider {
  SHOPIFY
  STRIPE
  RAZORPAY
  MANUAL
  INTERNAL
}

model MerchantSubscription {
  id            String @id @default(uuid())
  shopId        String @unique
  pricingPlanId String

  status          MerchantSubscriptionStatus @default(TRIALING)
  billingProvider BillingProvider            @default(INTERNAL)

  externalSubscriptionReference String?
  externalCustomerReference     String?
  providerStatus                String?
  confirmationUrl               String?
  providerActivatedAt           DateTime?
  providerMetadata              Json?

  trialStartsAt DateTime?
  trialEndsAt   DateTime?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  renewsAutomatically     Boolean   @default(true)
  canceledAt              DateTime?
  cancellationEffectiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop                       Shop                                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  pricingPlan                PricingPlan                         @relation(fields: [pricingPlanId], references: [id], onDelete: Restrict)
  billingPeriods             MerchantBillingPeriod[]
  billingProviderSubmissions MerchantBillingProviderSubmission[]
  planChanges                MerchantPlanChange[]

  @@index([pricingPlanId])
  @@index([status])
  @@index([billingProvider])
  @@index([currentPeriodEnd])
}

enum MerchantPlanChangeType {
  INITIAL_SUBSCRIPTION
  UPGRADE
  DOWNGRADE
  CANCEL
  REACTIVATE
}

enum MerchantPlanChangeTiming {
  IMMEDIATE
  PERIOD_END
}

enum MerchantPlanChangeStatus {
  PENDING
  PENDING_PROVIDER_CONFIRMATION
  SCHEDULED
  PROCESSING
  APPLIED
  CANCELED
  FAILED_RETRYABLE
  FAILED_FINAL
}

model MerchantPlanChange {
  id                     String                   @id @default(uuid())
  shopId                 String
  merchantSubscriptionId String
  fromPricingPlanId      String?
  toPricingPlanId        String?
  changeType             MerchantPlanChangeType
  timing                 MerchantPlanChangeTiming
  status                 MerchantPlanChangeStatus @default(PENDING)
  effectiveAt            DateTime?
  requestedAt            DateTime                 @default(now())
  confirmedAt            DateTime?
  appliedAt              DateTime?
  canceledAt             DateTime?
  failedAt               DateTime?
  provider               BillingProvider?
  providerSubmissionId   String?
  externalReference      String?
  idempotencyKey         String                   @unique
  failureCode            String?
  failureMessage         String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  shop                 Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  merchantSubscription MerchantSubscription @relation(fields: [merchantSubscriptionId], references: [id], onDelete: Cascade)
  fromPricingPlan      PricingPlan?         @relation("PlanChangeFrom", fields: [fromPricingPlanId], references: [id], onDelete: Restrict)
  toPricingPlan        PricingPlan?         @relation("PlanChangeTo", fields: [toPricingPlanId], references: [id], onDelete: Restrict)

  @@index([shopId, merchantSubscriptionId, status])
  @@index([status, effectiveAt, id])
}

enum BillingProviderOperation {
  CREATE_SUBSCRIPTION
  CREATE_USAGE_RECORD
}

enum BillingProviderSubmissionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_FINAL
}

model MerchantBillingProviderSubmission {
  id                         String                          @id @default(uuid())
  shopId                     String
  merchantSubscriptionId     String
  merchantBillingPeriodId    String?
  merchantRatedUsageId       String?
  provider                   BillingProvider
  operation                  BillingProviderOperation
  idempotencyKey             String
  status                     BillingProviderSubmissionStatus @default(PENDING)
  externalReference          String?
  externalParentReference    String?
  recurringLineItemReference String?
  usageLineItemReference     String?
  amount                     Decimal?                        @db.Decimal(18, 6)
  currency                   String?
  attemptCount               Int                             @default(0)
  lastAttemptAt              DateTime?
  succeededAt                DateTime?
  failedAt                   DateTime?
  errorCode                  String?
  errorMessage               String?
  requestSnapshot            Json?
  responseSnapshot           Json?
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt

  shop                 Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  merchantSubscription MerchantSubscription @relation(fields: [merchantSubscriptionId], references: [id], onDelete: Cascade)

  @@unique([provider, operation, idempotencyKey])
  @@unique([provider, operation, merchantRatedUsageId])
  @@index([shopId, status])
  @@index([merchantSubscriptionId, operation])
  @@index([merchantBillingPeriodId])
}

enum BillingReconciliationStatus {
  NOT_SUBMITTED
  PENDING
  MATCHED
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  MISSING_PROVIDER_REFERENCE
  DUPLICATE_PROVIDER_SUBMISSION
  PROVIDER_NOT_FOUND
  FAILED_RETRYABLE
  FAILED_FINAL
  SKIPPED_ZERO_AMOUNT
}

model MerchantBillingReconciliation {
  id                   String                      @id @default(uuid())
  shopId               String
  billingPeriodId      String
  merchantRatedUsageId String?
  provider             BillingProvider
  status               BillingReconciliationStatus
  internalAmount       Decimal?                    @db.Decimal(18, 6)
  internalCurrency     String?
  providerAmount       Decimal?                    @db.Decimal(18, 6)
  providerCurrency     String?
  providerSubmissionId String?
  externalReference    String?
  errorCode            String?
  errorMessage         String?
  checkedAt            DateTime                    @default(now())
  createdAt            DateTime                    @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, billingPeriodId, checkedAt])
  @@index([merchantRatedUsageId, checkedAt])
}

model MerchantBillingPeriod {
  id             String @id @default(uuid())
  shopId         String
  subscriptionId String

  periodStart DateTime
  periodEnd   DateTime

  status MerchantBillingPeriodStatus @default(OPEN)

  openedAt DateTime  @default(now())
  ratedAt  DateTime?
  closedAt DateTime?
  voidedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop         Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subscription MerchantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  ratedUsages  MerchantRatedUsage[]

  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([shopId, status])
  @@index([subscriptionId, status])
  @@index([shopId, periodStart, periodEnd])
  @@index([periodEnd])
}

model MerchantRatedUsage {
  id                String @id @default(uuid())
  shopId            String
  billingPeriodId   String
  pricingPlanId     String
  billableFeatureId String

  featureCodeSnapshot String
  featureNameSnapshot String?
  planCodeSnapshot    String
  planNameSnapshot    String?
  currency            String

  usedQuantity     Decimal @db.Decimal(18, 6)
  includedQuantity Decimal @db.Decimal(18, 6)
  billableQuantity Decimal @db.Decimal(18, 6)
  unitRate         Decimal @db.Decimal(18, 6)
  amount           Decimal @db.Decimal(18, 6)
  usageEventCount  Int

  ratedAt   DateTime @default(now())
  createdAt DateTime @default(now())

  shop            Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  billingPeriod   MerchantBillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  pricingPlan     PricingPlan           @relation(fields: [pricingPlanId], references: [id], onDelete: Restrict)
  billableFeature BillableFeature       @relation(fields: [billableFeatureId], references: [id], onDelete: Restrict)

  @@unique([billingPeriodId, billableFeatureId])
  @@index([shopId, billingPeriodId])
  @@index([pricingPlanId])
  @@index([featureCodeSnapshot])
}

model MerchantUsageEvent {
  id     String @id @default(uuid())
  shopId String

  usageType MerchantUsageType
  action    MerchantUsageAction
  provider  MerchantUsageProvider

  quantity      Decimal                    @db.Decimal(18, 6)
  status        MerchantUsageStatus        @default(RECORDED)
  billingStatus MerchantUsageBillingStatus @default(UNRATED)

  sourceType        String
  sourceId          String
  providerReference String?

  idempotencyKey String @unique

  countryCode String?
  metadata    Json?

  occurredAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, occurredAt])
  @@index([shopId, usageType, occurredAt])
  @@index([shopId, billingStatus, occurredAt])
  @@index([sourceType, sourceId])
  @@index([provider, occurredAt])
}

model MerchantNotificationSettings {
  id     String @id @default(uuid())
  shopId String @unique

  emailEnabled          Boolean @default(true)
  customerEmailsEnabled Boolean @default(true)

  senderDisplayName String?
  replyToEmail      String?
  adminRecipients   String[]

  cancellationAlerts Boolean @default(true)
  exchangeAlerts     Boolean @default(true)
  issueAlerts        Boolean @default(true)
  storeCreditAlerts  Boolean @default(true)
  checkoutAlerts     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

enum OtpProviderMode {
  PLATFORM_TWILIO
  MERCHANT_TWILIO
  MERCHANT_MSG91
  MOCK
}

enum OtpProviderStatus {
  NOT_CONFIGURED
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  SUSPENDED
  ERROR
}

model MerchantOtpSettings {
  id     String @id @default(uuid())
  shopId String @unique

  otpEnabled            Boolean         @default(true)
  providerMode          OtpProviderMode @default(PLATFORM_TWILIO)
  allowPlatformFallback Boolean         @default(true)
  defaultCountryCode    String          @default("IN")
  allowedCountryCodes   String[]        @default(["IN"])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop           Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  twilioSettings MerchantTwilioSettings?
  msg91Settings  MerchantMsg91Settings?

  @@index([shopId])
}

model MerchantTwilioSettings {
  id                    String @id @default(uuid())
  merchantOtpSettingsId String @unique

  accountSidMasked          String?
  accountSidEncrypted       String?
  authTokenEncrypted        String?
  verifyServiceSidMasked    String?
  verifyServiceSidEncrypted String?

  status                    OtpProviderStatus @default(NOT_CONFIGURED)
  verifiedAt                DateTime?
  lastVerifiedAt            DateTime?
  lastVerificationErrorCode String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  merchantOtpSettings MerchantOtpSettings @relation(fields: [merchantOtpSettingsId], references: [id], onDelete: Cascade)
}

model MerchantMsg91Settings {
  id                    String @id @default(uuid())
  merchantOtpSettingsId String @unique

  authKeyEncrypted    String?
  templateIdMasked    String?
  templateIdEncrypted String?
  senderId            String?

  status                    OtpProviderStatus @default(NOT_CONFIGURED)
  kycApproved               Boolean           @default(false)
  dltApproved               Boolean           @default(false)
  templateApproved          Boolean           @default(false)
  verifiedAt                DateTime?
  lastVerificationErrorCode String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  merchantOtpSettings MerchantOtpSettings @relation(fields: [merchantOtpSettingsId], references: [id], onDelete: Cascade)
}

enum PromotionRuleStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PromotionTriggerType {
  PRODUCT
  COLLECTION
  PRODUCT_TYPE
}

enum PromotionTriggerMatchMode {
  ANY
  ALL
}

enum PromotionRewardType {
  PERCENTAGE_OFF
  FIXED_AMOUNT_OFF
  FIXED_PRICE
}

enum PromotionRewardScope {
  PRODUCT
  ORDER
}

enum PromotionRewardMethod {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED_PRICE
}

enum PromotionTierSelectionMode {
  HIGHEST_ELIGIBLE
}

enum PromotionTierContinuityMode {
  CONTINUOUS
  ALLOW_GAPS
}

enum PromotionOrderDiscountBasis {
  ELIGIBLE_MERCHANDISE_SUBTOTAL
}

enum PromotionCompilationStatus {
  PENDING
  COMPILING
  READY
  FAILED
  SUPERSEDED
}

enum PromotionRuntimeSyncStateValue {
  NEVER_SYNCED
  SYNCING
  SYNCED
  FAILED
}

enum PromotionCompilationReason {
  RULE_CREATED
  RULE_UPDATED
  MANUAL_RECOMPILE
  COLLECTION_CHANGED
  PRODUCT_CHANGED
  PRODUCT_TYPE_CHANGED
  SCHEDULE_RECONCILIATION
  SYSTEM_REPAIR
}

model PromotionRule {
  id                            String                       @id @default(uuid())
  shopId                        String
  name                          String
  description                   String?
  status                        PromotionRuleStatus          @default(DRAFT)
  priority                      Int                          @default(0)
  triggerType                   PromotionTriggerType
  triggerMatchMode              PromotionTriggerMatchMode    @default(ANY)
  minimumTriggerQuantity        Int                          @default(1)
  minimumCartSubtotal           Decimal?                     @db.Decimal(18, 4)
  offerProductGid               String
  offerProductHandle            String?
  offerProductTitle             String?
  offerProductImageUrl          String?
  rewardType                    PromotionRewardType
  rewardValue                   Decimal                      @db.Decimal(18, 4)
  rewardScope                   PromotionRewardScope         @default(PRODUCT)
  rewardMethod                  PromotionRewardMethod?
  tierSelectionMode             PromotionTierSelectionMode?
  tierContinuityMode            PromotionTierContinuityMode?
  orderDiscountBasis            PromotionOrderDiscountBasis?
  maximumRewardQuantity         Int                          @default(1)
  heading                       String?
  badgeText                     String?
  customerMessage               String?
  ctaText                       String?
  combinesWithProductDiscounts  Boolean                      @default(false)
  combinesWithOrderDiscounts    Boolean                      @default(true)
  combinesWithShippingDiscounts Boolean                      @default(true)
  startsAt                      DateTime?
  endsAt                        DateTime?
  currentCompilationId          String?                      @unique
  compiledAt                    DateTime?
  createdByType                 String?
  createdById                   String?
  updatedByType                 String?
  updatedById                   String?
  archivedAt                    DateTime?
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt

  shop               Shop                        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  triggerReferences  PromotionTriggerReference[]
  orderTiers         PromotionOrderTier[]
  compilations       PromotionCompilation[]      @relation("PromotionRuleCompilations")
  auditLogs          PromotionAuditLog[]
  currentCompilation PromotionCompilation?       @relation("PromotionRuleCurrentCompilation", fields: [currentCompilationId], references: [id], onDelete: SetNull)

  @@index([shopId, status])
  @@index([shopId, priority])
  @@index([shopId, startsAt, endsAt])
  @@index([shopId, triggerType])
  @@index([shopId, offerProductGid])
  @@index([shopId, archivedAt])
}

model PromotionOrderTier {
  id              String   @id @default(uuid())
  publicId        String
  shopId          String
  promotionRuleId String
  minimumSubtotal Decimal  @db.Decimal(18, 4)
  maximumSubtotal Decimal? @db.Decimal(18, 4)
  percentage      Decimal  @db.Decimal(8, 4)
  position        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  promotionRule PromotionRule @relation(fields: [promotionRuleId], references: [id], onDelete: Cascade)

  @@unique([promotionRuleId, publicId])
